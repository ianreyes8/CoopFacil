{
  "name": "coopfacil-frontend",
  "private": true,
  "description": "Compila los estilos de Tailwind a CoopFacil/wwwroot/css/tailwind.css",
  "scripts": {
    "build": "tailwindcss -c tailwind.config.js -i input.css -o ../CoopFacil/wwwroot/css/tailwind.css --minify",
    "watch": "tailwindcss -c tailwind.config.js -i input.css -o ../CoopFacil/wwwroot/css/tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
