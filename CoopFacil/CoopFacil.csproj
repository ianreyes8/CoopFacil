<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CoopFacil</RootNamespace>
    <AssemblyName>CoopFacil</AssemblyName>
    <!-- El código de las páginas viene de Web Forms y no usa anotaciones de nulabilidad. -->
    <NoWarn>$(NoWarn);CS8632;SYSLIB0014</NoWarn>
    <!-- En Windows, el control de aplicaciones (Smart App Control) bloquea el CoopFacil.exe sin firmar.
         Sin ese .exe, "dotnet run" arranca la aplicación con el dotnet.exe firmado de Microsoft.
         En Linux (Railway) se conserva el ejecutable normal. -->
    <UseAppHost Condition="'$(OS)' == 'Windows_NT'">false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <!-- Conector ADO.NET para MariaDB / MySQL (reemplaza a System.Data.SqlClient) -->
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <!-- iTextSharp para .NET moderno (misma API iTextSharp.text.* que usaba el proyecto) -->
    <PackageReference Include="iTextSharp.LGPLv2.Core" Version="1.9.4" />
  </ItemGroup>

</Project>
