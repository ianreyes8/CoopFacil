<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!-- CONFIGURACIÓN DE PARÁMETROS Y SMTP PARA EL HELPER -->
	<appSettings>
		<add key="SmtpCorreoEmisor" value="leonardovassquez.2007@gmail.com" />
		<add key="SmtpPassword" value="mkct cjok iute iujw" />
		<add key="SmtpHost" value="smtp.gmail.com" />
		<add key="SmtpPort" value="587" />
		<add key="SmtpServer" value="smtp.gmail.com" />
		<add key="SmtpUser" value="leonardovassquez.2007@gmail.com" />
		<add key="SmtpPass" value="mkct cjok iute iujw" />
	</appSettings>

	<connectionStrings>
		<add name="CoopFacilDB"
			 connectionString="Data Source=localhost;Initial Catalog=CoopFacilDB;Integrated Security=True;"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<!-- CONFIGURACIÓN NATIVA DE CORREO NET FRAMEWORK -->
	<system.net>
		<mailSettings>
			<smtp deliveryMethod="Network" from="leonardovassquez.2007@gmail.com">
				<network host="smtp.gmail.com"
						 port="587"
						 userName="leonardovassquez.2007@gmail.com"
						 password="mkct cjok iute iujw"
						 enableSsl="true" />
			</smtp>
		</mailSettings>
	</system.net>

	<system.web>
		<compilation debug="true" targetFramework="4.8" />
		<httpRuntime targetFramework="4.8" />
	</system.web>
</configuration>