                            <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">SOLICITUD EN LÍNEA</span>
                            <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white">Formulario de Pre-Aprobación de Crédito Vehicular</h2>
                        </div>
                    </div>

                    @if (Model.pnlMensajeSolicitud.Visible) { <div id="pnlMensajeSolicitud" class="@Model.pnlMensajeSolicitud.CssClass">
                        @Model.Lit(Model.litMensajeSolicitud)
                    </div> }

                    <div class="flex flex-col gap-6">
                        
                        <!-- BLOQUE 1: DATOS PERSONALES Y VEHÍCULO -->
                        <div class="flex flex-col gap-4">
                            <h3 class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 border-b border-slate-200 dark:border-slate-800 pb-2 flex items-center gap-2">
                                <i class="fa-solid fa-user-gear text-sm"></i> 1. Datos Personales, Financieros y del Vehículo
                            </h3>

                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                                
                                <div class="flex flex-col gap-1.5">
                                    <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Nombre Completo <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                                    @if (Model.txtNombre.Visible) { <input type="text" id="txtNombre" name="txtNombre" class="@Model.txtNombre.CssClass" disabled="@(Model.txtNombre.Enabled ? null : "disabled")" autocomplete="off" oninput="filtrarSoloLetras(this)" placeholder="Ej. Leonardo Vásquez" value="@Model.txtNombre.Text" @Html.Raw(Model.txtNombre.AtributosExtra()) /> }
                                </div>

                                <div class="flex flex-col gap-1.5">
                                    <label class="text-xs font-bold text-slate-700 dark:text-slate-300">DUI <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                                    @if (Model.txtDUI.Visible) { <input type="text" id="txtDUI" name="txtDUI" class="@Model.txtDUI.CssClass" maxlength="10" disabled="@(Model.txtDUI.Enabled ? null : "disabled")" autocomplete="off" oninput="formatearDUI(this)" placeholder="00000000-0" value="@Model.txtDUI.Text" @Html.Raw(Model.txtDUI.AtributosExtra()) /> }
                                </div>

                                <div class="flex flex-col gap-1.5">
                                    <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Teléfono <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                                    @if (Model.txtTelefono.Visible) { <input type="text" id="txtTelefono" name="txtTelefono" class="@Model.txtTelefono.CssClass" maxlength="9" disabled="@(Model.txtTelefono.Enabled ? null : "disabled")" autocomplete="off" oninput="formatearTelefono(this)" placeholder="7777-8888" value="@Model.txtTelefono.Text" @Html.Raw(Model.txtTelefono.AtributosExtra()) /> }
                                </div>

                                <div class="flex flex-col gap-1.5">
                                    <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Correo Electrónico <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                                    @if (Model.txtCorreo.Visible) { <input type="email" id="txtCorreo" name="txtCorreo" class="@Model.txtCorreo.CssClass" disabled="@(Model.txtCorreo.Enabled ? null : "disabled")" autocomplete="off" placeholder="correo@@ejemplo.com" value="@Model.txtCorreo.Text" @Html.Raw(Model.txtCorreo.AtributosExtra()) /> }
                                </div>

                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
                                
                                <div class="flex flex-col gap-1.5">
                                    <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Ingresos Netos ($) <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                                    @if (Model.txtIngresos.Visible) { <input type="number" id="txtIngresos" name="txtIngresos" class="@Model.txtIngresos.CssClass" disabled="@(Model.txtIngresos.Enabled ? null : "disabled")" step="0.01" min="408.80" autocomplete="off" onkeydown="if(event.key==='-') event.preventDefault();" onblur="validarMinimoIngreso(this)" placeholder="Ej. 1200.00" value="@Model.txtIngresos.Text" @Html.Raw(Model.txtIngresos.AtributosExtra()) /> }
                                </div>

                                <div class="flex flex-col gap-1.5">
                                    <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Precio Vehículo ($) <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                                    @if (Model.txtPrecioVehiculo.Visible) { <input type="number" id="txtPrecioVehiculo" name="txtPrecioVehiculo" class="@Model.txtPrecioVehiculo.CssClass" disabled="@(Model.txtPrecioVehiculo.Enabled ? null : "disabled")" step="500" autocomplete="off" placeholder="18000" value="@Model.txtPrecioVehiculo.Text" @Html.Raw(Model.txtPrecioVehiculo.AtributosExtra()) /> }
                                </div>

                                <div class="flex flex-col gap-1.5">
                                    <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Monto Financiar ($) <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                                    @if (Model.txtMontoFinanciar.Visible) { <input type="number" id="txtMontoFinanciar" name="txtMontoFinanciar" class="@Model.txtMontoFinanciar.CssClass" disabled="@(Model.txtMontoFinanciar.Enabled ? null : "disabled")" step="100" autocomplete="off" placeholder="18000" value="@Model.txtMontoFinanciar.Text" @Html.Raw(Model.txtMontoFinanciar.AtributosExtra()) /> }
                                </div>

                                <div class="flex flex-col gap-1.5">
                                    <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Plazo Deseado <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                                    @if (Model.ddlPlazoVehicular.Visible) { <select id="ddlPlazoVehicular" name="ddlPlazoVehicular" class="@Model.ddlPlazoVehicular.CssClass" disabled="@(Model.ddlPlazoVehicular.Enabled ? null : "disabled")">@foreach (var item in Model.ddlPlazoVehicular.Items) { <option value="@item.Value" selected="@(item == Model.ddlPlazoVehicular.SelectedItem ? "selected" : null)">@item.Text</option> }</select> }
                                </div>

                            </div>
                        </div>

                        <!-- BLOQUE 2: RECOMENDACIONES DE LOCALIZACIÓN -->
                        <div class="flex flex-col gap-4">
                            <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-2">
                                <h3 class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 flex items-center gap-2">
                                    <i class="fa-solid fa-users text-sm"></i> 2. Recomendaciones de Localización (2 Personales y 2 Familiares)
                                </h3>
                                <span class="text-[10px] text-slate-500 dark:text-slate-400 italic">* Para localización en caso de mora</span>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                
                                <div class="bg-slate-50 dark:bg-[#0B1A30] border border-slate-200 dark:border-slate-800 rounded-xl p-4 flex flex-col gap-3">
                                    <span class="text-xs font-bold text-blue-600 dark:text-blue-400 uppercase tracking-wider">REFERENCIA PERSONAL 1 *</span>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                        @if (Model.txtRefPersonal1Nombre.Visible) { <input type="text" id="txtRefPersonal1Nombre" name="txtRefPersonal1Nombre" class="@Model.txtRefPersonal1Nombre.CssClass" disabled="@(Model.txtRefPersonal1Nombre.Enabled ? null : "disabled")" autocomplete="off" oninput="filtrarSoloLetras(this)" placeholder="Nombre completo" value="@Model.txtRefPersonal1Nombre.Text" @Html.Raw(Model.txtRefPersonal1Nombre.AtributosExtra()) /> }
                                        @if (Model.txtRefPersonal1Tel.Visible) { <input type="text" id="txtRefPersonal1Tel" name="txtRefPersonal1Tel" class="@Model.txtRefPersonal1Tel.CssClass" maxlength="9" disabled="@(Model.txtRefPersonal1Tel.Enabled ? null : "disabled")" autocomplete="off" oninput="formatearTelefono(this)" placeholder="7000-0000" value="@Model.txtRefPersonal1Tel.Text" @Html.Raw(Model.txtRefPersonal1Tel.AtributosExtra()) /> }
                                    </div>
                                </div>

                                <div class="bg-slate-50 dark:bg-[#0B1A30] border border-slate-200 dark:border-slate-800 rounded-xl p-4 flex flex-col gap-3">
                                    <span class="text-xs font-bold text-blue-600 dark:text-blue-400 uppercase tracking-wider">REFERENCIA PERSONAL 2 *</span>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                        @if (Model.txtRefPersonal2Nombre.Visible) { <input type="text" id="txtRefPersonal2Nombre" name="txtRefPersonal2Nombre" class="@Model.txtRefPersonal2Nombre.CssClass" disabled="@(Model.txtRefPersonal2Nombre.Enabled ? null : "disabled")" autocomplete="off" oninput="filtrarSoloLetras(this)" placeholder="Nombre completo" value="@Model.txtRefPersonal2Nombre.Text" @Html.Raw(Model.txtRefPersonal2Nombre.AtributosExtra()) /> }
                                        @if (Model.txtRefPersonal2Tel.Visible) { <input type="text" id="txtRefPersonal2Tel" name="txtRefPersonal2Tel" class="@Model.txtRefPersonal2Tel.CssClass" maxlength="9" disabled="@(Model.txtRefPersonal2Tel.Enabled ? null : "disabled")" autocomplete="off" oninput="formatearTelefono(this)" placeholder="7000-0000" value="@Model.txtRefPersonal2Tel.Text" @Html.Raw(Model.txtRefPersonal2Tel.AtributosExtra()) /> }
                                    </div>
                                </div>

                                <div class="bg-slate-50 dark:bg-[#0B1A30] border border-slate-200 dark:border-slate-800 rounded-xl p-4 flex flex-col gap-3">
                                    <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">REFERENCIA FAMILIAR 1 *</span>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                        @if (Model.txtRefFamiliar1Nombre.Visible) { <input type="text" id="txtRefFamiliar1Nombre" name="txtRefFamiliar1Nombre" class="@Model.txtRefFamiliar1Nombre.CssClass" disabled="@(Model.txtRefFamiliar1Nombre.Enabled ? null : "disabled")" autocomplete="off" oninput="filtrarSoloLetras(this)" placeholder="Nombre completo" value="@Model.txtRefFamiliar1Nombre.Text" @Html.Raw(Model.txtRefFamiliar1Nombre.AtributosExtra()) /> }
                                        @if (Model.txtRefFamiliar1Tel.Visible) { <input type="text" id="txtRefFamiliar1Tel" name="txtRefFamiliar1Tel" class="@Model.txtRefFamiliar1Tel.CssClass" maxlength="9" disabled="@(Model.txtRefFamiliar1Tel.Enabled ? null : "disabled")" autocomplete="off" oninput="formatearTelefono(this)" placeholder="7000-0000" value="@Model.txtRefFamiliar1Tel.Text" @Html.Raw(Model.txtRefFamiliar1Tel.AtributosExtra()) /> }
                                    </div>
                                </div>

                                <div class="bg-slate-50 dark:bg-[#0B1A30] border border-slate-200 dark:border-slate-800 rounded-xl p-4 flex flex-col gap-3">
                                    <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">REFERENCIA FAMILIAR 2 *</span>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                        @if (Model.txtRefFamiliar2Nombre.Visible) { <input type="text" id="txtRefFamiliar2Nombre" name="txtRefFamiliar2Nombre" class="@Model.txtRefFamiliar2Nombre.CssClass" disabled="@(Model.txtRefFamiliar2Nombre.Enabled ? null : "disabled")" autocomplete="off" oninput="filtrarSoloLetras(this)" placeholder="Nombre completo" value="@Model.txtRefFamiliar2Nombre.Text" @Html.Raw(Model.txtRefFamiliar2Nombre.AtributosExtra()) /> }
                                        @if (Model.txtRefFamiliar2Tel.Visible) { <input type="text" id="txtRefFamiliar2Tel" name="txtRefFamiliar2Tel" class="@Model.txtRefFamiliar2Tel.CssClass" maxlength="9" disabled="@(Model.txtRefFamiliar2Tel.Enabled ? null : "disabled")" autocomplete="off" oninput="formatearTelefono(this)" placeholder="7000-0000" value="@Model.txtRefFamiliar2Tel.Text" @Html.Raw(Model.txtRefFamiliar2Tel.AtributosExtra()) /> }
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- BLOQUE 3: ADJUNTAR COMPROBANTES Y PROFORMA -->
                        <div class="flex flex-col gap-4">
                            <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-2">
                                <h3 class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 flex items-center gap-2">
                                    <i class="fa-solid fa-paperclip text-sm"></i> 3. Adjuntar Comprobantes y Proforma (Agua/Luz / Constancia / Cotización)
                                </h3>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                                
                                <div class="bg-slate-50 dark:bg-[#0B1A30] border border-slate-200 dark:border-slate-800 rounded-xl p-5 flex flex-col justify-between gap-3">
                                    <div class="flex flex-col gap-2">
                                        <label class="text-xs font-bold text-slate-900 dark:text-white flex items-center gap-2">
                                            <i class="fa-solid fa-file-invoice text-emerald-600 dark:text-emerald-400"></i> Recibo de Agua / Luz o DUI <span class="text-emerald-600 dark:text-emerald-400">*</span>
                                        </label>
                                        @if (Model.fulRecibo.Visible) { <input type="file" id="fulRecibo" name="fulRecibo" class="@Model.fulRecibo.CssClass" onchange="verificarArchivo(this, 'btnQuitarRecibo', 'lblStatusRecibo')" /> }
                                        <span id="lblStatusRecibo" class="hidden text-[11px] font-bold text-emerald-600 dark:text-emerald-400 mt-1"></span>
                                        <button type="button" id="btnQuitarRecibo" onclick="limpiarFileUpload('fulRecibo', 'btnQuitarRecibo', 'lblStatusRecibo')" class="hidden mt-1 w-full bg-red-500/10 hover:bg-red-500/20 text-red-600 dark:text-red-400 border border-red-500/30 font-bold px-3 py-2 rounded-xl text-xs transition flex items-center justify-center gap-1.5" title="Quitar archivo seleccionado">
                                            <i class="fa-solid fa-trash-can"></i> Quitar Archivo
                                        </button>
                                    </div>
                                    <span class="text-[10px] text-slate-400 dark:text-slate-500">Formatos recomendados: .pdf, .jpg, .png (Máx. 5MB)</span>
                                </div>

                                <div class="bg-slate-50 dark:bg-[#0B1A30] border border-slate-200 dark:border-slate-800 rounded-xl p-5 flex flex-col justify-between gap-3">
                                    <div class="flex flex-col gap-2">
                                        <label class="text-xs font-bold text-slate-900 dark:text-white flex items-center gap-2">
                                            <i class="fa-solid fa-file-signature text-emerald-600 dark:text-emerald-400"></i> Constancia de Sueldo <span class="text-emerald-600 dark:text-emerald-400">*</span>
                                        </label>
                                        @if (Model.fulConstancia.Visible) { <input type="file" id="fulConstancia" name="fulConstancia" class="@Model.fulConstancia.CssClass" onchange="verificarArchivo(this, 'btnQuitarConstancia', 'lblStatusConstancia')" /> }
                                        <span id="lblStatusConstancia" class="hidden text-[11px] font-bold text-emerald-600 dark:text-emerald-400 mt-1"></span>
                                        <button type="button" id="btnQuitarConstancia" onclick="limpiarFileUpload('fulConstancia', 'btnQuitarConstancia', 'lblStatusConstancia')" class="hidden mt-1 w-full bg-red-500/10 hover:bg-red-500/20 text-red-600 dark:text-red-400 border border-red-500/30 font-bold px-3 py-2 rounded-xl text-xs transition flex items-center justify-center gap-1.5" title="Quitar archivo seleccionado">
                                            <i class="fa-solid fa-trash-can"></i> Quitar Archivo
                                        </button>
                                    </div>
                                    <span class="text-[10px] text-slate-400 dark:text-slate-500">Formatos recomendados: .pdf, .jpg, .png (Máx. 5MB)</span>
                                </div>

                                <div class="bg-slate-50 dark:bg-[#0B1A30] border border-slate-200 dark:border-slate-800 rounded-xl p-5 flex flex-col justify-between gap-3">
                                    <div class="flex flex-col gap-2">
                                        <label class="text-xs font-bold text-slate-900 dark:text-white flex items-center gap-2">
                                            <i class="fa-solid fa-car-side text-emerald-600 dark:text-emerald-400"></i> Proforma / Cotización Auto <span class="text-emerald-600 dark:text-emerald-400">*</span>
                                        </label>
                                        @if (Model.fulCotizacion.Visible) { <input type="file" id="fulCotizacion" name="fulCotizacion" class="@Model.fulCotizacion.CssClass" onchange="verificarArchivo(this, 'btnQuitarCotizacion', 'lblStatusCotizacion')" /> }
                                        <span id="lblStatusCotizacion" class="hidden text-[11px] font-bold text-emerald-600 dark:text-emerald-400 mt-1"></span>
                                        <button type="button" id="btnQuitarCotizacion" onclick="limpiarFileUpload('fulCotizacion', 'btnQuitarCotizacion', 'lblStatusCotizacion')" class="hidden mt-1 w-full bg-red-500/10 hover:bg-red-500/20 text-red-600 dark:text-red-400 border border-red-500/30 font-bold px-3 py-2 rounded-xl text-xs transition flex items-center justify-center gap-1.5" title="Quitar archivo seleccionado">
                                            <i class="fa-solid fa-trash-can"></i> Quitar Archivo
                                        </button>
                                    </div>
                                    <span class="text-[10px] text-slate-400 dark:text-slate-500">Formatos recomendados: .pdf, .jpg, .png (Máx. 5MB)</span>
                                </div>

                            </div>
                        </div>

                        <!-- BOTÓN DE ENVÍO -->
                        @if (Model.btnEnviarSolicitud.Visible) { <input type="submit" name="btnEnviarSolicitud" id="btnEnviarSolicitud" value="@Model.btnEnviarSolicitud.Text" class="@Model.btnEnviarSolicitud.CssClass" @Html.Raw(Model.btnEnviarSolicitud.AtributosExtra()) /> }

                    </div>

                </section>

            </main>
        </div>

        <footer class="bg-white dark:bg-[#0F233D] border-t border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 text-xs text-center py-6 mt-auto transition-colors duration-300">
            <p>© @(DateTime.Now.Year) CoopFacil. Todos los derechos reservados.</p>
        </footer>

    </form>

    <script>
        function updateThemeIcons(isDark) {
            const sunIcon = document.getElementById('themeIconSun');
            const moonIcon = document.getElementById('themeIconMoon');
            if (isDark) {
                sunIcon.classList.remove('hidden');
                moonIcon.classList.add('hidden');
            } else {
                sunIcon.classList.add('hidden');
                moonIcon.classList.remove('hidden');
            }
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('coopfacil-theme', isDark ? 'dark' : 'light');
            updateThemeIcons(isDark);
        }

        function filtrarSoloLetras(input) {
            if (!input) return;
            input.value = input.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ\s]/g, '');
        }

        function formatearTelefono(input) {
            if (!input) return;
            let val = input.value.replace(/\D/g, '');
            if (val.length > 8) val = val.substring(0, 8);
            if (val.length > 4) {
                input.value = val.substring(0, 4) + '-' + val.substring(4, 8);
            } else {
                input.value = val;
            }
        }

        function formatearDUI(input) {
            if (!input) return;
            let val = input.value.replace(/\D/g, '');
            if (val.length > 9) val = val.substring(0, 9);
            if (val.length > 8) {
                input.value = val.substring(0, 8) + '-' + val.substring(8, 9);
            } else {
                input.value = val;
            }
        }

        function formatearMontoInput(input) {
            if (!input) return;
            let valorLimpio = input.value.replace(/[^0-9]/g, '');
            if (valorLimpio === '') {
                input.value = '';
                return;
            }
            let numero = parseInt(valorLimpio, 10);
            input.value = numero.toLocaleString('en-US');
        }

        function validarMinimoIngreso(input) {
            if (!input || input.value === '') return;
            let val = parseFloat(input.value);
            if (isNaN(val) || val < 408.80) {
                alert('El ingreso mensual neto no puede ser negativo ni menor al salario mínimo vigente de El Salvador ($408.80 USD).');
                input.value = '408.80';
            }
        }

        function verificarArchivo(input, idBtnQuitar, idStatus) {
            const btn = document.getElementById(idBtnQuitar);
            const lbl = document.getElementById(idStatus);
            if (input.files && input.files.length > 0) {
                const file = input.files[0];
                if (btn) btn.classList.remove('hidden');
                if (lbl) {
                    lbl.innerText = '✓ Archivo listo: ' + file.name;
                    lbl.classList.remove('hidden');
                }
            } else {
                if (btn) btn.classList.add('hidden');
                if (lbl) {
                    lbl.innerText = '';
                    lbl.classList.add('hidden');
                }
            }
        }

        function limpiarFileUpload(idFileUpload, idBtnQuitar, idStatus) {
            const input = document.getElementById(idFileUpload);
            if (input) input.value = '';
            const btn = document.getElementById(idBtnQuitar);
            if (btn) btn.classList.add('hidden');
            const lbl = document.getElementById(idStatus);
            if (lbl) {
                lbl.innerText = '';
                lbl.classList.add('hidden');
            }
        }

        function calcularCreditoVehicular() {
            const rawVal = document.getElementById('simPrecioAuto').value.replace(/,/g, '');
            const precioAuto = parseFloat(rawVal) || 18000;
            const plazo = parseInt(document.getElementById('simPlazoVehicular').value) || 48;

            const montoFinanciar = precioAuto;

            const tasaAnual = 0.10; // 10% ANUAL
            const tasaMensual = tasaAnual / 12.0;

            const cuotaBase = (montoFinanciar * tasaMensual) / (1 - Math.pow(1 + tasaMensual, -plazo));
            
            const seguroVida = 5.00;
            const seguroDanos = 15.00;
            const cuotaTotal = cuotaBase + seguroVida + seguroDanos;

            const interesMes1 = montoFinanciar * tasaMensual;
            const capitalMes1 = cuotaBase - interesMes1;

            const pctCapital = ((capitalMes1 / cuotaTotal) * 100).toFixed(1);
            const pctInteres = ((interesMes1 / cuotaTotal) * 100).toFixed(1);
            const pctVida = ((seguroVida / cuotaTotal) * 100).toFixed(1);
            const pctDanos = ((seguroDanos / cuotaTotal) * 100).toFixed(1);

            document.getElementById('lblMontoFinanciarText').innerText = '$' + montoFinanciar.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('lblCuotaEstimadaVehicular').innerText = '$' + cuotaTotal.toFixed(2);
            
            document.getElementById('lblAbonoCapitalVehicular').innerText = '$' + capitalMes1.toFixed(2);
            document.getElementById('lblCapitalPct').innerText = pctCapital + '%';

            document.getElementById('lblInteresMesVehicular').innerText = '$' + interesMes1.toFixed(2);
            document.getElementById('lblInteresPct').innerText = pctInteres + '%';

            document.getElementById('lblSeguroVidaVehicular').innerText = '$' + seguroVida.toFixed(2);
            document.getElementById('lblSeguroVidaPct').innerText = pctVida + '%';

            document.getElementById('lblSeguroDanosVehicular').innerText = '$' + seguroDanos.toFixed(2);
            document.getElementById('lblSeguroDanosPct').innerText = pctDanos + '%';

            document.getElementById('barCapital').style.width = pctCapital + '%';
            document.getElementById('barInteres').style.width = pctInteres + '%';
            document.getElementById('barVida').style.width = pctVida + '%';
            document.getElementById('barDanos').style.width = pctDanos + '%';

            const txtPrecioForm = document.getElementById('txtPrecioVehiculo');
            const txtMontoForm = document.getElementById('txtMontoFinanciar');
            const ddlPlazoForm = document.getElementById('ddlPlazoVehicular');
            if (txtPrecioForm) txtPrecioForm.value = precioAuto;
            if (txtMontoForm) txtMontoForm.value = montoFinanciar;
            if (ddlPlazoForm) ddlPlazoForm.value = plazo;

            let htmlTabla = '';
            let saldo = montoFinanciar;

            for (let i = 1; i <= Math.min(4, plazo); i++) {
                let interes = saldo * tasaMensual;
                let capital = cuotaBase - interes;
                saldo -= capital;

                htmlTabla += `
                    <tr>
                        <td class="p-3 font-bold text-emerald-600 dark:text-emerald-400">Mes ${i}</td>
                        <td class="p-3">$${cuotaBase.toFixed(2)}</td>
                        <td class="p-3">$${interes.toFixed(2)}</td>
                        <td class="p-3">$${capital.toFixed(2)}</td>
                        <td class="p-3 font-bold">$${Math.max(0, saldo).toFixed(2)}</td>
                    </tr>`;
            }

            document.getElementById('tblAmortizacionVehicular').innerHTML = htmlTabla;
            document.getElementById('lblMensajeTablaVehicular').innerText = `... (${plazo - Math.min(4, plazo)} meses restantes con la misma cuota base de $${cuotaBase.toFixed(2)}) ...`;
        }

        document.addEventListener('DOMContentLoaded', function () {
            const isDark = document.documentElement.classList.contains('dark');
            updateThemeIcons(isDark);

            calcularCreditoVehicular();
        });
    </script>
<script src="~/Js/menu-movil.js" asp-append-version="true"></script>
<script src="~/Js/formularios.js" asp-append-version="true"></script>
<script src="~/Js/efectos.js" asp-append-version="true"></script>
