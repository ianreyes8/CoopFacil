@page "/Pages/CuentaAhorro.aspx"
@model CoopFacil.Pages.CuentaAhorro
@{
    Layout = null;
}

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="es" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cuenta de Ahorro - CoopFacil</title>
    <meta name="description" content="CoopFacil: cooperativa de ahorro y crédito. Abre tu cuenta, solicita créditos con tasa preferencial y envía dinero a otros socios." />
    <meta name="theme-color" content="#0B1A30" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/estilos.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/paginas.css" asp-append-version="true" />
    <script>
    (function () {
        const savedTheme = localStorage.getItem('coopfacil-theme');
        if (savedTheme === 'light') { document.documentElement.classList.remove('dark'); }
        else { document.documentElement.classList.add('dark'); }
    })();
    </script>
</head>
<body class="bg-slate-50 dark:bg-[#0B1A30] text-slate-800 dark:text-slate-100 font-sans antialiased min-h-screen flex flex-col justify-between transition-colors duration-300">
    <form method="post" id="form1" autocomplete="off" class="min-h-screen flex flex-col justify-between">@Model.CamposOcultos()
        
        <div>
            <!-- BARRA DE NAVEGACIÓN PRINCIPAL -->
            <header class="bg-white/90 dark:bg-[#0B1A30]/95 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 sticky top-0 z-50 w-full px-6 sm:px-10 py-4 flex items-center justify-between gap-4 transition-colors duration-300">
                
                <div class="flex items-center gap-4">
                    <a href="../Index.aspx" class="flex items-center gap-3 group">
                        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 dark:bg-emerald-600/20 border border-emerald-500/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 text-xl shadow-inner group-hover:scale-105 transition-transform">
                            <i class="fa-solid fa-users-gear"></i>
                        </div>
                        <div class="flex flex-col">
                            <span class="text-xl font-extrabold tracking-tight leading-none text-slate-900 dark:text-white">
                                Coop<span class="text-emerald-600 dark:text-emerald-400">Facil</span>
                            </span>
                            <span class="hidden sm:block text-[9px] font-bold tracking-widest text-slate-500 dark:text-slate-400 uppercase mt-1">
                                COOPERATIVA FINANCIERA
                            </span>
                        </div>
                    </a>

                    @if (Model.pnlBienvenida.Visible) { <partial name="_MenuPerfil" model="Model" /> }
                </div>

                <nav class="hidden lg:flex items-center gap-8 text-sm font-semibold">
                    <a href="../Index.aspx" class="text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition pb-1 border-b-2 border-transparent">Inicio</a>
                    <a href="QuienesSomos.aspx" class="text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition pb-1 border-b-2 border-transparent">Quiénes Somos</a>
                    <a href="Servicios.aspx" class="text-emerald-600 dark:text-emerald-400 font-bold border-b-2 border-emerald-600 dark:border-emerald-400 pb-1">Servicios</a>
                    <a href="Transparencia.aspx" class="text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition pb-1 border-b-2 border-transparent">Transparencia</a>
                    <a href="Contacto.aspx" class="text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition pb-1 border-b-2 border-transparent">Contacto</a>
                    @if (Model.Session["IdUsuario"] != null) { <a href="@Url.Content("~/Pages/Transferencias.aspx")" class="text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition pb-1 border-b-2 border-transparent">Transferencias</a> }
                </nav>

                <div class="flex items-center gap-3">
                    <button type="button" onclick="toggleTheme()" id="themeToggleBtn" title="Cambiar Tema" class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-[#0F233D] border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-amber-400 hover:bg-slate-200 dark:hover:bg-slate-800 transition flex items-center justify-center text-base shadow-sm">
                        <i id="themeIconSun" class="fa-solid fa-sun hidden"></i>
                        <i id="themeIconMoon" class="fa-solid fa-moon"></i>
                    </button>

                    @if (Model.lnkIniciarSesion.Visible) { <a id="lnkIniciarSesion" class="@Model.lnkIniciarSesion.CssClass" href="@Url.Content(Model.lnkIniciarSesion.NavigateUrl)">
                        <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i> <span class="hidden min-[400px]:inline">Iniciar Sesión</span><span class="sr-only min-[400px]:hidden">Iniciar Sesión</span>
                    </a> }

                    @if (Model.btnCerrarSesion.Visible) { <a id="btnCerrarSesion" class="@Model.btnCerrarSesion.CssClass" href="javascript:__doPostBack('btnCerrarSesion','')">
                        <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i> <span class="hidden min-[400px]:inline">Cerrar Sesión</span><span class="sr-only min-[400px]:hidden">Cerrar Sesión</span>
                    </a> }
                </div>

            </header>

            <!-- CONTENIDO PRINCIPAL -->
            <main class="max-w-7xl mx-auto px-6 py-10 flex flex-col gap-8 flex-grow w-full">
                
                <!-- BOTÓN VOLVER AL PORTAFOLIO DE SERVICIOS -->
                <a href="Servicios.aspx" class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline flex items-center gap-2 w-fit">
                    <i class="fa-solid fa-arrow-left"></i> Volver al Portafolio de Servicios
                </a>

                <!-- HERO / ENCABEZADO PRODUCTO -->
                <div class="bg-white dark:bg-[#0F233D] border border-slate-200 dark:border-slate-800 rounded-2xl p-6 sm:p-8 text-center flex flex-col items-center gap-3 shadow-sm dark:shadow-xl">
                    <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-xs font-bold uppercase tracking-wider">
                        <i class="fa-solid fa-wallet"></i> PRODUCTO DE AHORRO & DESEMBOLSO
                    </span>
                    <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white">Cuenta de Ahorro</h1>
                    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 max-w-xl">
                        Plataforma central de captación y recepción de fondos desembolsados por créditos aprobados en CoopFácil.
                    </p>
                </div>

                <!-- TARJETA INFORMACIÓN DEL TITULAR Y Nº DE CUENTA -->
                <div class="bg-white dark:bg-[#0F233D] border border-slate-200 dark:border-slate-800 rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-sm dark:shadow-xl">
                    <div class="flex items-center gap-4">
                        <div class="w-14 h-14 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 text-2xl">
                            <i class="fa-solid fa-id-card"></i>
                        </div>
                        <div class="flex flex-col">
                            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">TITULAR DE LA CUENTA</span>
                            <span class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white">
                                @Model.Lit(Model.litTitularCuenta)
                            </span>
                        </div>
                    </div>

                    <div class="bg-slate-50 dark:bg-[#0B1A30] border border-slate-200 dark:border-slate-800 px-6 py-3 rounded-xl flex items-center gap-4 w-full sm:w-auto justify-between sm:justify-start">
                        <i class="fa-solid fa-hashtag text-emerald-600 dark:text-emerald-400 text-lg"></i>
                        <div class="flex flex-col">
                            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Nº DE CUENTA</span>
                            <span class="text-lg font-black text-emerald-600 dark:text-emerald-400 tracking-wider">
                                @Model.Lit(Model.litNumeroCuenta)
                            </span>
                        </div>
                    </div>
                </div>

                <!-- BANNER DE SALDO DISPONIBLE -->
                <div class="bg-gradient-to-r from-emerald-600 to-teal-700 text-white rounded-2xl p-8 flex flex-col items-center justify-center text-center gap-3 shadow-xl">
                    <span class="text-xs font-bold tracking-widest uppercase opacity-90">REFLEJO DEL DINERO DESEMBOLSADO DE LOS CRÉDITOS</span>
                    <div class="text-4xl sm:text-5xl font-black">
                        $@Model.Lit(Model.litSaldoDisponible) USD
                    </div>
                    <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-xs font-semibold backdrop-blur-sm">
                        <i class="fa-solid fa-circle-check text-emerald-300"></i> Fondos disponibles abonados directamente por créditos adquiridos
                    </span>
                </div>

                <!-- TABLA DE CRÉDITOS ADQUIRIDOS -->
                <div class="bg-white dark:bg-[#0F233D] border border-slate-200 dark:border-slate-800 rounded-2xl p-6 sm:p-8 shadow-sm dark:shadow-xl flex flex-col gap-6">
                    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-blue-500/20 border border-blue-400/40 flex items-center justify-center text-blue-600 dark:text-blue-400 text-xl">
                                <i class="fa-solid fa-list-check"></i>
                            </div>
                            <div>
                                <h2 class="text-xl font-bold text-slate-900 dark:text-white">Reflejo de los Créditos Adquiridos con la Cooperativa</h2>
                                <p class="text-xs text-slate-500 dark:text-slate-400">Detalle de préstamos solicitados y aprobados por el titular</p>
                            </div>
                        </div>
                        <span class="bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/30 text-xs font-bold px-3 py-1 rounded-full">
                            @Model.Lit(Model.litCantidadCreditos)
                        </span>
                    </div>

                    <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
                        <table class="w-full text-left text-xs">
                            <thead class="bg-slate-100 dark:bg-[#0B1A30] text-slate-600 dark:text-slate-300 font-bold border-b border-slate-200 dark:border-slate-800 uppercase tracking-wider">
                                <tr>
                                    <th class="p-4">N° TRANSACCIÓN</th>
                                    <th class="p-4">TIPO DE CRÉDITO</th>
                                    <th class="p-4">MONTO APROBADO</th>
                                    <th class="p-4">PLAZO</th>
                                    <th class="p-4">CUOTA MENSUAL</th>
                                    <th class="p-4">FECHA SOLICITUD</th>
                                </tr>
                            </thead>
                            <tbody id="tblCreditos" class="divide-y divide-slate-200 dark:divide-slate-800 text-slate-700 dark:text-slate-200 font-medium">@Html.Raw(Model.tblCreditos.InterioHtml())</tbody>
                        </table>
                    </div>
                </div>

            </main>
        </div>

        <footer class="bg-white dark:bg-[#0F233D] border-t border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 text-xs text-center py-6 mt-auto transition-colors duration-300">
            <p>© @(DateTime.Now.Year) CoopFacil. Todos los derechos reservados.</p>
        </footer>

    </form>

    <script>
        function updateThemeIcons(isDark) {
            const sunIcon = document.getElementById('themeIconSun');
            const moonIcon = document.getElementById('themeIconMoon');
            if (isDark) {
                sunIcon.classList.remove('hidden');
                moonIcon.classList.add('hidden');
            } else {
                sunIcon.classList.add('hidden');
                moonIcon.classList.remove('hidden');
            }
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('coopfacil-theme', isDark ? 'dark' : 'light');
            updateThemeIcons(isDark);
        }

        document.addEventListener('DOMContentLoaded', function () {
            const isDark = document.documentElement.classList.contains('dark');
            updateThemeIcons(isDark);
        });
    </script>
<script src="~/Js/menu-movil.js" asp-append-version="true"></script>
<script src="~/Js/efectos.js" asp-append-version="true"></script>
    <partial name="_PostBack" />
</body>
</html>