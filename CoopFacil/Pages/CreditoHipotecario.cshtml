@page "/Pages/CreditoHipotecario.aspx"
@model CoopFacil.Pages.CreditoHipotecario
@{
    Layout = null;
}

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="es" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Crédito Hipotecario - CoopFacil</title>
    <meta name="description" content="CoopFacil: cooperativa de ahorro y crédito. Abre tu cuenta, solicita créditos con tasa preferencial y envía dinero a otros socios." />
    <meta name="theme-color" content="#0B1A30" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/estilos.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/paginas.css" asp-append-version="true" />
    <script>
    (function () {
        const savedTheme = localStorage.getItem('coopfacil-theme');
        if (savedTheme === 'light') { document.documentElement.classList.remove('dark'); }
        else { document.documentElement.classList.add('dark'); }
    })();
</script>
</head>
<body class="bg-slate-50 dark:bg-[#0B1A30] text-slate-800 dark:text-slate-100 font-sans antialiased min-h-screen flex flex-col justify-between transition-colors duration-300">
    <form method="post" id="form1" autocomplete="off" class="min-h-screen flex flex-col justify-between">@Model.CamposOcultos()
        
        <div>
            <!-- BARRA DE NAVEGACIÓN PRINCIPAL -->
            <header class="bg-white/90 dark:bg-[#0B1A30]/95 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 sticky top-0 z-50 w-full px-6 sm:px-10 py-4 flex items-center justify-between gap-4 transition-colors duration-300">
                
                <!-- LOGO COOPFACIL + SALUDO SI HAY SESIÓN -->
                <div class="flex items-center gap-4">
                    <a href="../Index.aspx" class="flex items-center gap-3 group">
                        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 dark:bg-emerald-600/20 border border-emerald-500/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 text-xl shadow-inner group-hover:scale-105 transition-transform">
                            <i class="fa-solid fa-users-gear"></i>
                        </div>
                        <div class="flex flex-col">
                            <span class="text-xl font-extrabold tracking-tight leading-none text-slate-900 dark:text-white">
                                Coop<span class="text-emerald-600 dark:text-emerald-400">Facil</span>
                            </span>
                            <span class="hidden sm:block text-[9px] font-bold tracking-widest text-slate-500 dark:text-slate-400 uppercase mt-1">
                                COOPERATIVA FINANCIERA
                            </span>
                        </div>
                    </a>

                    <!-- MENSAJE DE BIENVENIDA SI TIENE SESIÓN ACTIVA -->
                    @if (Model.pnlBienvenida.Visible) { <partial name="_MenuPerfil" model="Model" /> }
                </div>

                <!-- ENLACES DE NAVEGACIÓN (CENTRO) -->
                <nav class="hidden lg:flex items-center gap-8 text-sm font-semibold">
                    <a href="../Index.aspx" class="text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition pb-1 border-b-2 border-transparent">Inicio</a>
                    <a href="QuienesSomos.aspx" class="text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition pb-1 border-b-2 border-transparent">Quiénes Somos</a>
                    <a href="Servicios.aspx" class="text-emerald-600 dark:text-emerald-400 font-bold border-b-2 border-emerald-600 dark:border-emerald-400 pb-1">Servicios</a>
                    <a href="Transparencia.aspx" class="text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition pb-1 border-b-2 border-transparent">Transparencia</a>
                    <a href="Contacto.aspx" class="text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition pb-1 border-b-2 border-transparent">Contacto</a>
                    @if (Model.Session["IdUsuario"] != null) { <a href="@Url.Content("~/Pages/Transferencias.aspx")" class="text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition pb-1 border-b-2 border-transparent">Transferencias</a> }
                </nav>

                <!-- CONTROLES DE SESIÓN Y TEMA (DERECHA) -->
                <div class="flex items-center gap-3">
                    <button type="button" onclick="toggleTheme()" id="themeToggleBtn" title="Cambiar Tema" class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-[#0F233D] border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-amber-400 hover:bg-slate-200 dark:hover:bg-slate-800 transition flex items-center justify-center text-base shadow-sm">
                        <i id="themeIconSun" class="fa-solid fa-sun hidden"></i>
                        <i id="themeIconMoon" class="fa-solid fa-moon"></i>
                    </button>

                    @if (Model.lnkIniciarSesion.Visible) { <a id="lnkIniciarSesion" class="@Model.lnkIniciarSesion.CssClass" href="@Url.Content(Model.lnkIniciarSesion.NavigateUrl)">
                        <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i> <span class="hidden min-[400px]:inline">Iniciar Sesión</span><span class="sr-only min-[400px]:hidden">Iniciar Sesión</span>
                    </a> }

                    @if (Model.btnCerrarSesion.Visible) { <a id="btnCerrarSesion" class="@Model.btnCerrarSesion.CssClass" href="javascript:__doPostBack('btnCerrarSesion','')">
                        <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i> <span class="hidden min-[400px]:inline">Cerrar Sesión</span><span class="sr-only min-[400px]:hidden">Cerrar Sesión</span>
                    </a> }
                </div>

            </header>

            <!-- CONTENIDO PRINCIPAL -->
            <main class="max-w-7xl mx-auto px-6 py-10 flex flex-col gap-10 flex-grow w-full">
                
                <!-- ÁREA DEL CRÉDITO (TITULAR Y CONDICIONES) -->
                <div class="flex flex-col gap-3">
                    <a href="Servicios.aspx" class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline flex items-center gap-2 w-fit">
                        <i class="fa-solid fa-arrow-left"></i> Volver al Portafolio de Servicios
                    </a>
                    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 mt-2">
                        <div>
                            <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">CRÉDITO DE VIVIENDA Y REMODELACIÓN</span>
                            <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight flex items-center gap-3 mt-1">
                                <i class="fa-solid fa-house-chimney text-emerald-600 dark:text-emerald-400"></i> Crédito Hipotecario
                            </h1>
                        </div>
                        <div class="bg-white dark:bg-[#0F233D] border border-emerald-500/40 px-4 py-2 rounded-xl flex items-center gap-3 shadow-sm dark:shadow-lg">
                            <span class="text-xs text-slate-600 dark:text-slate-300 font-medium">Tasa Preferencial Vivienda:</span>
                            <span class="text-lg font-black text-emerald-600 dark:text-emerald-400">10% ANUAL</span>
                        </div>
                    </div>
                    <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed max-w-3xl">
                        Financiamiento a largo plazo para compra de vivienda nueva o usada, construcción en terreno propio o remodelación. Obtén cuotas accesibles, plazos de hasta 20 años y asesoría personalizada de principio a fin.
                    </p>
                </div>

                <!-- BLOQUE SUPERIOR: SIMULADOR HIPOTECARIO (IZQ) Y DESGLOSE DE CUOTA (DER) -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                    
                    <!-- IZQUIERDA: SIMULADOR HIPOTECARIO (SIN PRIMA + TABLA RESUMIDA) -->
                    <div class="lg:col-span-6 bg-white dark:bg-[#0F233D] border border-slate-200 dark:border-slate-700/80 rounded-2xl p-6 shadow-sm dark:shadow-xl flex flex-col gap-6">
                        <div class="flex items-center gap-3 border-b border-slate-200 dark:border-slate-800 pb-4">
                            <div class="w-10 h-10 rounded-xl bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 text-xl">
                                <i class="fa-solid fa-calculator"></i>
                            </div>
                            <div>
                                <h2 class="text-xl font-bold text-slate-900 dark:text-white">Calculadora Hipotecaria</h2>
                                <p class="text-xs text-slate-500 dark:text-slate-400">Calcula tu cuota con financiamiento hasta 20 años (10% ANUAL)</p>
                            </div>
                        </div>

                        <!-- VALOR TOTAL DEL INMUEBLE (CON COMAS EN MILLARES) -->
                        <div class="flex flex-col gap-2">
                            <label class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase">Valor Total del Inmueble ($ USD)</label>
                            <div class="relative">
                                <span class="absolute left-3.5 top-2.5 text-slate-500 dark:text-slate-400 font-bold">$</span>
                                <input type="text" id="simValorPropiedad" value="100,000" oninput="formatearMontoComas(this); calcularSimuladorHipotecario();" class="w-full bg-slate-50 dark:bg-[#0B1A30] border border-slate-300 dark:border-slate-700 rounded-xl pl-8 pr-3 py-2.5 text-xs font-bold text-slate-900 dark:text-white focus:outline-none focus:border-emerald-500 transition" placeholder="100,000" />
                            </div>
                        </div>

                        <!-- PLAZO DE FINANCIAMIENTO -->
                        <div class="flex flex-col gap-2">
                            <label class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase">Plazo de Financiamiento</label>
                            <select id="simPlazoAnios" onchange="calcularSimuladorHipotecario()" class="w-full bg-slate-50 dark:bg-[#0B1A30] border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-2.5 text-xs font-bold text-slate-900 dark:text-white focus:outline-none focus:border-emerald-500 transition">
                                <option value="5">5 Años (60 Meses)</option>
                                <option value="10">10 Años (120 Meses)</option>
                                <option value="15">15 Años (180 Meses)</option>
                                <option value="20" selected="selected">20 Años (240 Meses)</option>
                            </select>
                        </div>

                        <!-- MONTO TOTAL A FINANCIAR (IGUAL AL VALOR DEL INMUEBLE) -->
                        <div class="bg-slate-100 dark:bg-[#0B1A30] border border-slate-200 dark:border-slate-800 rounded-xl p-4 flex justify-between items-center text-xs">
                            <span class="text-slate-500 dark:text-slate-400 font-bold uppercase">Monto Total a Financiar:</span>
                            <span id="lblMontoFinanciar" class="text-lg font-black text-emerald-600 dark:text-emerald-400">$100,000.00</span>
                        </div>

                        <!-- TABLA RESUMIDA DE LOS PRIMEROS MESES -->
                        <div class="flex flex-col gap-2">
                            <span class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase flex items-center gap-2">
                                <i class="fa-solid fa-table-list text-emerald-600 dark:text-emerald-400"></i> Tabla Resumida de los Primeros Meses
                            </span>
                            <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
                                <table class="w-full text-left text-[11px] text-slate-700 dark:text-slate-300">
                                    <thead class="bg-slate-100 dark:bg-[#0B1A30] text-emerald-600 dark:text-emerald-400 font-bold uppercase border-b border-slate-200 dark:border-slate-800">
                                        <tr>
                                            <th class="py-2 px-3">Mes</th>
                                            <th class="py-2 px-3">Cuota Base</th>
                                            <th class="py-2 px-3">Interés</th>
                                            <th class="py-2 px-3">Capital</th>
                                            <th class="py-2 px-3 text-right">Saldo Restante</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tblAmortizacionBody" class="divide-y divide-slate-200 dark:divide-slate-800/60 font-medium">
                                        <!-- Generado dinámicamente -->
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <span class="text-[11px] text-slate-500 dark:text-slate-400 italic text-center">
                            * Cálculo estimado sobre sistema de cuota nivelada a Tasa Efectiva Anual del 10.00%.
                        </span>
                    </div>

                    <!-- DERECHA: DESGLOSE DE CUOTA ESTIMADA (CAPITAL, INTERESES, SEGUROS) -->
                    <div class="lg:col-span-6 bg-white dark:bg-[#0F233D] border border-slate-200 dark:border-slate-700/80 rounded-2xl p-6 shadow-sm dark:shadow-xl flex flex-col gap-6">
                        <div class="flex items-center gap-3 border-b border-slate-200 dark:border-slate-800 pb-4">
                            <div class="w-10 h-10 rounded-xl bg-blue-500/20 border border-blue-400/30 flex items-center justify-center text-blue-600 dark:text-blue-400 text-xl">
                                <i class="fa-solid fa-chart-pie"></i>
                            </div>
                            <div>
                                <h2 class="text-xl font-bold text-slate-900 dark:text-white">Desglose de Cuota Estimada</h2>
                                <p class="text-xs text-slate-500 dark:text-slate-400">Incluye capital, intereses y estimación de seguros obligatorios</p>
                            </div>
                        </div>

                        <!-- CUOTA TOTAL DESTACADA -->
                        <div class="bg-slate-100 dark:bg-[#0B1A30] border border-emerald-500/40 rounded-xl p-5 text-center flex flex-col items-center justify-center shadow-inner">
                            <span class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Cuota Total Mensual Estimada</span>
                            <span id="lblCuotaTotal" class="text-3xl font-black text-emerald-600 dark:text-emerald-400 mt-1">$1,014.82</span>
                            <span class="text-[10px] text-slate-500 dark:text-slate-400 mt-1">* Cuota fija estimada durante todo el plazo</span>
                        </div>

                        <!-- BARRA VISUAL DE DISTRIBUCIÓN -->
                        <div class="space-y-4">
                            <span class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase block border-b border-slate-200 dark:border-slate-800 pb-2">Distribución de la Cuota (Mes 1):</span>

                            <div class="w-full bg-slate-100 dark:bg-[#0B1A30] h-3 rounded-full overflow-hidden flex border border-slate-200 dark:border-slate-800 p-0.5">
                                <div id="barCapital" class="bg-emerald-500 h-full rounded-l-full transition-all duration-300" style="width: 13%;"></div>
                                <div id="barInteres" class="bg-blue-500 h-full transition-all duration-300" style="width: 82%;"></div>
                                <div id="barSegVida" class="bg-purple-500 h-full transition-all duration-300" style="width: 3%;"></div>
                                <div id="barSegDanos" class="bg-amber-500 h-full rounded-r-full transition-all duration-300" style="width: 2%;"></div>
                            </div>

                            <!-- FILAS DE DESGLOSE INDIVIDUAL -->
                            <div class="space-y-2 text-xs">
                                
                                <div class="bg-slate-50 dark:bg-[#0B1A30] border border-slate-200 dark:border-slate-800 rounded-xl p-3 flex items-center justify-between">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-7 h-7 rounded-lg bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xs">
                                            <i class="fa-solid fa-building-columns"></i>
                                        </div>
                                        <span class="font-bold text-slate-900 dark:text-white">Abono Directo a Capital:</span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <span id="lblPctCapital" class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold">12.9%</span>
                                        <span id="lblDesgloseCapital" class="font-extrabold text-emerald-600 dark:text-emerald-400">$131.49</span>
                                    </div>
                                </div>

                                <div class="bg-slate-50 dark:bg-[#0B1A30] border border-slate-200 dark:border-slate-800 rounded-xl p-3 flex items-center justify-between">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-7 h-7 rounded-lg bg-blue-500/20 text-blue-600 dark:text-blue-400 flex items-center justify-center text-xs">
                                            <i class="fa-solid fa-percent"></i>
                                        </div>
                                        <span class="font-bold text-slate-900 dark:text-white">Intereses Financieros (10% ANUAL):</span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <span id="lblPctInteres" class="text-[10px] text-blue-600 dark:text-blue-400 font-semibold">82.1%</span>
                                        <span id="lblDesgloseInteres" class="font-extrabold text-blue-600 dark:text-blue-400">$833.33</span>
                                    </div>
                                </div>

                                <div class="bg-slate-50 dark:bg-[#0B1A30] border border-slate-200 dark:border-slate-800 rounded-xl p-3 flex items-center justify-between">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-7 h-7 rounded-lg bg-purple-500/20 text-purple-600 dark:text-purple-400 flex items-center justify-center text-xs">
                                            <i class="fa-solid fa-heart-pulse"></i>
                                        </div>
                                        <span class="font-bold text-slate-900 dark:text-white">Seguro de Vida Colectivo:</span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <span id="lblPctSegVida" class="text-[10px] text-purple-600 dark:text-purple-400 font-semibold">3.0%</span>
                                        <span id="lblSeguroVida" class="font-extrabold text-purple-600 dark:text-purple-300">$30.00</span>
                                    </div>
                                </div>

                                <div class="bg-slate-50 dark:bg-[#0B1A30] border border-slate-200 dark:border-slate-800 rounded-xl p-3 flex items-center justify-between">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-7 h-7 rounded-lg bg-amber-500/20 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xs">
                                            <i class="fa-solid fa-shield-halved"></i>
                                        </div>
                                        <span class="font-bold text-slate-900 dark:text-white">Seguro de Daños / Incendio:</span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <span id="lblPctSegDanos" class="text-[10px] text-amber-600 dark:text-amber-400 font-semibold">2.0%</span>
                                        <span id="lblSeguroDanos" class="font-extrabold text-amber-600 dark:text-amber-300">$20.00</span>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <span class="text-[11px] text-slate-500 dark:text-slate-400 italic text-center mt-1">
                            * Proyección orientativa sujeta a aprobación de crédito y avalúo comercial del inmueble.
                        </span>
                    </div>

                </div>

                <!-- SECCIÓN REQUISITOS -->
                <section class="bg-white dark:bg-[#0F233D] border border-slate-200 dark:border-slate-700/80 rounded-2xl p-6 sm:p-8 shadow-sm dark:shadow-xl flex flex-col gap-6">
                    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-blue-500/20 border border-blue-400/30 flex items-center justify-center text-blue-600 dark:text-blue-400 text-xl">
                                <i class="fa-solid fa-folder-open"></i>
                            </div>
                            <div>
                                <h2 class="text-xl font-bold text-slate-900 dark:text-white">Requisitos para Solicitud de Crédito Hipotecario</h2>
                                <p class="text-xs text-slate-500 dark:text-slate-400">Documentación y referencias obligatorias previas al avalúo y escrituración</p>
                            </div>
                        </div>
                        <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 bg-slate-50 dark:bg-[#0B1A30] border border-emerald-500/30 px-3.5 py-1.5 rounded-xl">
                            <i class="fa-solid fa-check-double"></i> Verificación Digital y Legal
                        </span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                        
                        <div class="bg-slate-50 dark:bg-[#0B1A30] border border-slate-200 dark:border-slate-800 rounded-xl p-4 flex items-center justify-between gap-3 hover:border-emerald-500/50 transition">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-base flex-shrink-0">
                                    <i class="fa-solid fa-id-card"></i>
                                </div>
                                <div class="flex flex-col">
                                    <span class="text-xs font-bold text-slate-900 dark:text-white">1. DUI Vigente</span>
                                    <span class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Ambos lados legibles</span>
                                </div>
                            </div>
                            <i class="fa-solid fa-circle-check text-emerald-600 dark:text-emerald-400 text-lg flex-shrink-0"></i>
                        </div>

                        <div class="bg-slate-50 dark:bg-[#0B1A30] border border-slate-200 dark:border-slate-800 rounded-xl p-4 flex items-center justify-between gap-3 hover:border-emerald-500/50 transition">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-base flex-shrink-0">
                                    <i class="fa-solid fa-file-invoice-dollar"></i>
                                </div>
                                <div class="flex flex-col">
                                    <span class="text-xs font-bold text-slate-900 dark:text-white">2. Constancia de Sueldo</span>
                                    <span class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Emisión reciente firmada</span>
                                </div>
                            </div>
                            <i class="fa-solid fa-circle-check text-emerald-600 dark:text-emerald-400 text-lg flex-shrink-0"></i>
                        </div>

                        <div class="bg-slate-50 dark:bg-[#0B1A30] border border-slate-200 dark:border-slate-800 rounded-xl p-4 flex items-center justify-between gap-3 hover:border-emerald-500/50 transition">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-base flex-shrink-0">
                                    <i class="fa-solid fa-receipt"></i>
                                </div>
                                <div class="flex flex-col">
                                    <span class="text-xs font-bold text-slate-900 dark:text-white">3. Recibo Agua / Luz</span>
                                    <span class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Comprobante de domicilio</span>
                                </div>
                            </div>
                            <i class="fa-solid fa-circle-check text-emerald-600 dark:text-emerald-400 text-lg flex-shrink-0"></i>
                        </div>

                        <div class="bg-slate-50 dark:bg-[#0B1A30] border border-slate-200 dark:border-slate-800 rounded-xl p-4 flex items-center justify-between gap-3 hover:border-emerald-500/50 transition">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-base flex-shrink-0">
                                    <i class="fa-solid fa-users"></i>
                                </div>
                                <div class="flex flex-col">
                                    <span class="text-xs font-bold text-slate-900 dark:text-white">4. Recomendaciones</span>
                                    <span class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">4 contactos (2 fam / 2 pers)</span>
                                </div>
                            </div>
                            <i class="fa-solid fa-circle-check text-emerald-600 dark:text-emerald-400 text-lg flex-shrink-0"></i>
                        </div>

                    </div>

                    <div class="bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-500/30 rounded-xl p-3.5 text-xs text-blue-800 dark:text-blue-200 flex items-center gap-3">
                        <i class="fa-solid fa-circle-info text-blue-600 dark:text-blue-400 text-base"></i>
                        <span>Las 4 recomendaciones se utilizarán para comunicación directa únicamente en caso de atrasos en el pago de cuotas o localización de respaldo.</span>
                    </div>
                </section>

                <!-- SECCIÓN GUÍA DE PASOS DEL PROCESO -->
                <section class="bg-white dark:bg-[#0F233D] border border-slate-200 dark:border-slate-700/80 rounded-2xl p-6 sm:p-8 shadow-sm dark:shadow-xl flex flex-col gap-6">
                    <div class="flex items-center gap-3 border-b border-slate-200 dark:border-slate-800 pb-4">
                        <div class="w-10 h-10 rounded-xl bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 text-xl">
                            <i class="fa-solid fa-diagram-project"></i>
                        </div>
                        <div>
                            <h2 class="text-xl font-bold text-slate-900 dark:text-white">Guía del Proceso de Crédito Hipotecario</h2>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Flujograma transparente desde el primer paso hasta la entrega de llaves</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 relative">
                        
                        <div class="bg-slate-50 dark:bg-[#0B1A30] border border-slate-200 dark:border-slate-800 rounded-xl p-5 flex flex-col gap-3 relative group hover:border-emerald-500/50 transition">
                            <div class="flex items-center justify-between">
                                <span class="w-8 h-8 rounded-lg bg-emerald-600/20 text-emerald-600 dark:text-emerald-400 font-black text-sm flex items-center justify-center border border-emerald-500/30">1</span>
                                <i class="fa-solid fa-calculator text-slate-400 dark:text-slate-500 text-lg group-hover:text-emerald-500 transition"></i>
                            </div>
                            <h3 class="text-sm font-bold text-slate-900 dark:text-white">1. Pre-Calificación</h3>
                            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                                Calcula tu crédito e ingresa tu solicitud para verificar tu capacidad de pago y el monto pre-aprobado.
                            </p>
                        </div>

                        <div class="bg-slate-50 dark:bg-[#0B1A30] border border-slate-200 dark:border-slate-800 rounded-xl p-5 flex flex-col gap-3 relative group hover:border-emerald-500/50 transition">
                            <div class="flex items-center justify-between">
                                <span class="w-8 h-8 rounded-lg bg-emerald-600/20 text-emerald-600 dark:text-emerald-400 font-black text-sm flex items-center justify-center border border-emerald-500/30">2</span>
                                <i class="fa-solid fa-magnifying-glass-location text-slate-400 dark:text-slate-500 text-lg group-hover:text-emerald-500 transition"></i>
                            </div>
                            <h3 class="text-sm font-bold text-slate-900 dark:text-white">2. Avalúo del Inmueble</h3>
                            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                                Un perito valuador autorizado realiza la inspección física y comercial de la propiedad.
                            </p>
                        </div>

                        <div class="bg-slate-50 dark:bg-[#0B1A30] border border-slate-200 dark:border-slate-800 rounded-xl p-5 flex flex-col gap-3 relative group hover:border-emerald-500/50 transition">
                            <div class="flex items-center justify-between">
                                <span class="w-8 h-8 rounded-lg bg-emerald-600/20 text-emerald-600 dark:text-emerald-400 font-black text-sm flex items-center justify-center border border-emerald-500/30">3</span>
                                <i class="fa-solid fa-file-check text-slate-400 dark:text-slate-500 text-lg group-hover:text-emerald-500 transition"></i>
                            </div>
                            <h3 class="text-sm font-bold text-slate-900 dark:text-white">3. Análisis Legal y Aprobación</h3>
                            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                                Revisión de antecedentes registrales en el CNR y emisión de la carta de aprobación formal.
                            </p>
                        </div>

                        <div class="bg-slate-50 dark:bg-[#0B1A30] border border-slate-200 dark:border-slate-800 rounded-xl p-5 flex flex-col gap-3 relative group hover:border-emerald-500/50 transition">
                            <div class="flex items-center justify-between">
                                <span class="w-8 h-8 rounded-lg bg-emerald-600/20 text-emerald-600 dark:text-emerald-400 font-black text-sm flex items-center justify-center border border-emerald-500/30">4</span>
                                <i class="fa-solid fa-key text-slate-400 dark:text-slate-500 text-lg group-hover:text-emerald-500 transition"></i>
                            </div>
                            <h3 class="text-sm font-bold text-slate-900 dark:text-white">4. Escrituración y Desembolso</h3>
                            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                                Firma de escritura pública de compraventa e hipoteca ante notario y desembolso de fondos.
                            </p>
                        </div>

                    </div>
                </section>

                <!-- SECCIÓN AGENDAMIENTO DE CITA -->
                <section class="bg-white dark:bg-[#0F233D] border border-slate-200 dark:border-emerald-500/40 rounded-2xl p-6 sm:p-8 shadow-sm dark:shadow-2xl relative overflow-hidden flex flex-col gap-6">
                    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-6">
                        <div>
                            <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest block">ASESORÍA PERSONALIZADA</span>
                            <h2 class="text-2xl font-extrabold text-slate-900 dark:text-white mt-1 flex items-center gap-2">
                                <i class="fa-solid fa-calendar-days text-emerald-600 dark:text-emerald-400"></i> Agendamiento de Cita con Ejecutivo de Ventas
                            </h2>
                            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-1">
                                Selecciona el día, la hora, la modalidad e ingresa tus datos para recibir atención exclusiva sobre tu crédito de vivienda.
                            </p>
                        </div>
                        <div class="hidden sm:flex items-center gap-2 bg-slate-50 dark:bg-[#0B1A30] border border-slate-300 dark:border-slate-700 px-3.5 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-300">
                            <i class="fa-solid fa-user-tie text-emerald-600 dark:text-emerald-400 text-sm"></i> Ejecutivo Especialista en Crédito Hipotecario
                        </div>
                    </div>

                    <!-- MENSAJE DE FEEDBACK -->
                    @if (Model.pnlMensaje.Visible) { <div id="pnlMensaje" class="@Model.pnlMensaje.CssClass">
                        @Model.Lit(Model.litMensaje)
                    </div> }

                    <!-- FORMULARIO DE DATOS PERSONALES Y CITA -->
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
                        
                        <!-- NOMBRE COMPLETO -->
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Nombre Completo <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                            @if (Model.txtNombre.Visible) { <input type="text" id="txtNombre" name="txtNombre" class="@Model.txtNombre.CssClass" disabled="@(Model.txtNombre.Enabled ? null : "disabled")" oninput="filtrarSoloLetras(this)" placeholder="Ej. Carlos Alberto Mendoza" value="@Model.txtNombre.Text" @Html.Raw(Model.txtNombre.AtributosExtra()) /> }
                        </div>

                        <!-- DUI -->
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Documento de Identidad (DUI) <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                            @if (Model.txtDUI.Visible) { <input type="text" id="txtDUI" name="txtDUI" class="@Model.txtDUI.CssClass" maxlength="10" disabled="@(Model.txtDUI.Enabled ? null : "disabled")" oninput="formatearDUI(this)" placeholder="00000000-0" value="@Model.txtDUI.Text" @Html.Raw(Model.txtDUI.AtributosExtra()) /> }
                        </div>

                        <!-- TELÉFONO -->
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Teléfono de Contacto <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                            @if (Model.txtTelefono.Visible) { <input type="text" id="txtTelefono" name="txtTelefono" class="@Model.txtTelefono.CssClass" maxlength="9" disabled="@(Model.txtTelefono.Enabled ? null : "disabled")" oninput="formatearTelefono(this)" placeholder="7777-8888" value="@Model.txtTelefono.Text" @Html.Raw(Model.txtTelefono.AtributosExtra()) /> }
                        </div>

                        <!-- CORREO ELECTRÓNICO -->
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Correo Electrónico <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                            @if (Model.txtCorreo.Visible) { <input type="email" id="txtCorreo" name="txtCorreo" class="@Model.txtCorreo.CssClass" disabled="@(Model.txtCorreo.Enabled ? null : "disabled")" placeholder="correo@@ejemplo.com" value="@Model.txtCorreo.Text" @Html.Raw(Model.txtCorreo.AtributosExtra()) /> }
                        </div>

                        <!-- MODALIDAD DE ATENCIÓN -->
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Modalidad de Atención <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                            @if (Model.ddlModalidad.Visible) { <select id="ddlModalidad" name="ddlModalidad" class="@Model.ddlModalidad.CssClass" disabled="@(Model.ddlModalidad.Enabled ? null : "disabled")" onchange="toggleAgencia(this.value)">@foreach (var item in Model.ddlModalidad.Items) { <option value="@item.Value" selected="@(item == Model.ddlModalidad.SelectedItem ? "selected" : null)">@item.Text</option> }</select> }
                        </div>

                        <!-- AGENCIA PREFERIDA -->
                        <div id="divAgencia" class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Agencia Preferida <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                            @if (Model.ddlAgencia.Visible) { <select id="ddlAgencia" name="ddlAgencia" class="@Model.ddlAgencia.CssClass" disabled="@(Model.ddlAgencia.Enabled ? null : "disabled")">@foreach (var item in Model.ddlAgencia.Items) { <option value="@item.Value" selected="@(item == Model.ddlAgencia.SelectedItem ? "selected" : null)">@item.Text</option> }</select> }
                        </div>

                        <!-- FECHA DE CITA -->
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Fecha de Cita <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                            @if (Model.txtFechaCita.Visible) { <input type="date" id="txtFechaCita" name="txtFechaCita" class="@Model.txtFechaCita.CssClass" disabled="@(Model.txtFechaCita.Enabled ? null : "disabled")" value="@Model.txtFechaCita.Text" @Html.Raw(Model.txtFechaCita.AtributosExtra()) /> }
                        </div>

                        <!-- HORA DE CITA -->
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Hora de Cita <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                            @if (Model.ddlHoraCita.Visible) { <select id="ddlHoraCita" name="ddlHoraCita" class="@Model.ddlHoraCita.CssClass" disabled="@(Model.ddlHoraCita.Enabled ? null : "disabled")">@foreach (var item in Model.ddlHoraCita.Items) { <option value="@item.Value" selected="@(item == Model.ddlHoraCita.SelectedItem ? "selected" : null)">@item.Text</option> }</select> }
                        </div>

                    </div>

                    <div class="mt-2 flex justify-end">
                        @if (Model.btnAgendarCita.Visible) { <input type="submit" name="btnAgendarCita" id="btnAgendarCita" value="@Model.btnAgendarCita.Text" class="@Model.btnAgendarCita.CssClass" @Html.Raw(Model.btnAgendarCita.AtributosExtra()) /> }
                    </div>
                </section>

            </main>
        </div>

        <footer class="bg-white dark:bg-[#0F233D] border-t border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 text-xs text-center py-6 mt-auto transition-colors duration-300">
            <p>© @(DateTime.Now.Year) CoopFacil. Todos los derechos reservados.</p>
        </footer>

    </form>

    <!-- SCRIPTS DE SIMULADOR, RESTRICCIONES Y MÁSCARAS -->
    <script>
        function updateThemeIcons(isDark) {
            const sunIcon = document.getElementById('themeIconSun');
            const moonIcon = document.getElementById('themeIconMoon');
            if (isDark) {
                sunIcon.classList.remove('hidden');
                moonIcon.classList.add('hidden');
            } else {
                sunIcon.classList.add('hidden');
                moonIcon.classList.remove('hidden');
            }
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('coopfacil-theme', isDark ? 'dark' : 'light');
            updateThemeIcons(isDark);
        }

        // 1. RESTRICCIÓN: Solo letras, espacios y tildes/ñ
        function filtrarSoloLetras(input) {
            if (!input) return;
            input.value = input.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ\s]/g, '');
        }

        // 2. MÁSCARA DUI: Solo números con guion automático (00000000-0)
        function formatearDUI(input) {
            if (!input) return;
            let val = input.value.replace(/\D/g, '');
            if (val.length > 9) val = val.substring(0, 9);

            if (val.length > 8) {
                input.value = val.substring(0, 8) + '-' + val.substring(8, 9);
            } else {
                input.value = val;
            }
        }

        // 3. MÁSCARA TELÉFONO: Solo números con guion en la mitad (0000-0000)
        function formatearTelefono(input) {
            if (!input) return;
            let val = input.value.replace(/\D/g, '');
            if (val.length > 8) val = val.substring(0, 8);

            if (val.length > 4) {
                input.value = val.substring(0, 4) + '-' + val.substring(4, 8);
            } else {
                input.value = val;
            }
        }

        // 4. FORMATEAR MONTO CON COMAS EN MILLARES
        function formatearMontoComas(input) {
            if (!input) return;
            let value = input.value.replace(/[^0-9.]/g, '');
            let parts = value.split('.');
            parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
            if (parts.length > 2) {
                parts = [parts[0], parts.slice(1).join('')];
            }
            input.value = parts.join('.');
        }

        // CÁLCULO DEL SIMULADOR HIPOTECARIO A TASA 10% ANUAL + TABLA RESUMIDA
        function calcularSimuladorHipotecario() {
            const inputValor = document.getElementById('simValorPropiedad');
            if (!inputValor) return;

            const rawValor = inputValor.value.replace(/,/g, '');
            const valProp = parseFloat(rawValor) || 0;
            const anios = parseInt(document.getElementById('simPlazoAnios').value) || 20;

            if (valProp <= 0) {
                document.getElementById('lblMontoFinanciar').innerText = '$0.00';
                document.getElementById('lblCuotaTotal').innerText = '$0.00';
                document.getElementById('lblDesgloseCapital').innerText = '$0.00';
                document.getElementById('lblDesgloseInteres').innerText = '$0.00';
                document.getElementById('lblSeguroVida').innerText = '$0.00';
                document.getElementById('lblSeguroDanos').innerText = '$0.00';
                document.getElementById('tblAmortizacionBody').innerHTML = '';
                return;
            }

            const montoFinanciar = valProp;
            const plazoMeses = anios * 12;
            const tasaAnual = 0.10;
            const tasaMensual = tasaAnual / 12;

            const factor = Math.pow(1 + tasaMensual, plazoMeses);
            const cuotaBase = montoFinanciar * (tasaMensual * factor) / (factor - 1);

            const seguroVida = montoFinanciar * 0.0003;
            const seguroDanos = valProp * 0.0002;
            const cuotaTotal = cuotaBase + seguroVida + seguroDanos;

            const interesMes1 = montoFinanciar * tasaMensual;
            const capitalMes1 = cuotaBase - interesMes1;

            const pctCapital = (capitalMes1 / cuotaTotal) * 100;
            const pctInteres = (interesMes1 / cuotaTotal) * 100;
            const pctSegVida = (seguroVida / cuotaTotal) * 100;
            const pctSegDanos = (seguroDanos / cuotaTotal) * 100;

            document.getElementById('lblMontoFinanciar').innerText = '$' + montoFinanciar.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('lblCuotaTotal').innerText = '$' + cuotaTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            document.getElementById('lblDesgloseCapital').innerText = '$' + capitalMes1.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('lblDesgloseInteres').innerText = '$' + interesMes1.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('lblSeguroVida').innerText = '$' + seguroVida.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('lblSeguroDanos').innerText = '$' + seguroDanos.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            document.getElementById('lblPctCapital').innerText = pctCapital.toFixed(1) + '%';
            document.getElementById('lblPctInteres').innerText = pctInteres.toFixed(1) + '%';
            document.getElementById('lblPctSegVida').innerText = pctSegVida.toFixed(1) + '%';
            document.getElementById('lblPctSegDanos').innerText = pctSegDanos.toFixed(1) + '%';

            document.getElementById('barCapital').style.width = pctCapital.toFixed(1) + '%';
            document.getElementById('barInteres').style.width = pctInteres.toFixed(1) + '%';
            document.getElementById('barSegVida').style.width = pctSegVida.toFixed(1) + '%';
            document.getElementById('barSegDanos').style.width = pctSegDanos.toFixed(1) + '%';

            let saldo = montoFinanciar;
            let tbodyHtml = '';
            const mesesMostrar = Math.min(plazoMeses, 4);

            for (let m = 1; m <= mesesMostrar; m++) {
                const interesMes = saldo * tasaMensual;
                const capitalMes = cuotaBase - interesMes;
                saldo -= capitalMes;

                tbodyHtml += `
                    <tr>
                        <td class="py-2 px-3 font-bold text-slate-900 dark:text-white">Mes ${m}</td>
                        <td class="py-2 px-3 text-emerald-600 dark:text-emerald-400 font-bold">$${cuotaBase.toFixed(2)}</td>
                        <td class="py-2 px-3 text-slate-700 dark:text-slate-300">$${interesMes.toFixed(2)}</td>
                        <td class="py-2 px-3 text-slate-700 dark:text-slate-300">$${capitalMes.toFixed(2)}</td>
                        <td class="py-2 px-3 text-right text-slate-900 dark:text-slate-300 font-bold">$${Math.max(saldo, 0).toFixed(2)}</td>
                    </tr>
                `;
            }

            if (plazoMeses > 4) {
                tbodyHtml += `
                    <tr class="bg-slate-100 dark:bg-[#0F233D]/60 italic text-slate-500 dark:text-slate-400">
                        <td colspan="5" class="py-1.5 px-3 text-center text-[10px]">... (${plazoMeses - 4} meses restantes con la misma cuota base de $${cuotaBase.toFixed(2)}) ...</td>
                    </tr>
                `;
            }

            document.getElementById('tblAmortizacionBody').innerHTML = tbodyHtml;
        }

        function toggleAgencia(modalidad) {
            const divAgencia = document.getElementById('divAgencia');
            if (divAgencia) {
                if (modalidad === 'Videollamada') {
                    divAgencia.style.display = 'none';
                } else {
                    divAgencia.style.display = 'flex';
                }
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            const isDark = document.documentElement.classList.contains('dark');
            updateThemeIcons(isDark);

            calcularSimuladorHipotecario();
        });
    </script>
<script src="~/Js/menu-movil.js" asp-append-version="true"></script>
<script src="~/Js/formularios.js" asp-append-version="true"></script>
<script src="~/Js/efectos.js" asp-append-version="true"></script>
    <partial name="_PostBack" />
</body>
