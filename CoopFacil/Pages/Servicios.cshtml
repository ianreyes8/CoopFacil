@page "/Pages/Servicios.aspx"
@model CoopFacil.Pages.Servicios
@{
    Layout = null;
}

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="es" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Servicios Financieros - CoopFacil</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
tailwind.config = {
    darkMode: 'class',
    theme: {
        extend: {
            colors: { coop: { darkBg: '#0B1A30', darkCard: '#0F233D', emerald: '#10B981', blue: '#3B82F6' } }
        }
    }
}
</script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script>
        (function () {
            const savedTheme = localStorage.getItem('coopfacil-theme');
            if (savedTheme === 'light') { document.documentElement.classList.remove('dark'); }
            else { document.documentElement.classList.add('dark'); }
        })();
    </script>
</head>
<body class="bg-slate-50 dark:bg-[#0B1A30] text-slate-800 dark:text-slate-100 font-sans antialiased min-h-screen flex flex-col justify-between transition-colors duration-300">
    <form method="post" id="form1" class="min-h-screen flex flex-col justify-between">@Model.CamposOcultos()
        
        <div>
            <!-- BARRA DE NAVEGACIÓN PRINCIPAL -->
            <header class="bg-white/90 dark:bg-[#0B1A30]/95 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 sticky top-0 z-50 w-full px-6 sm:px-10 py-4 flex items-center justify-between gap-4 transition-colors duration-300">
                
                <div class="flex items-center gap-4">
                    <a href="../Index.aspx" class="flex items-center gap-3 group">
                        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 dark:bg-emerald-600/20 border border-emerald-500/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 text-xl shadow-inner group-hover:scale-105 transition-transform">
                            <i class="fa-solid fa-users-gear"></i>
                        </div>
                        <div class="flex flex-col">
                            <span class="text-xl font-extrabold tracking-tight leading-none text-slate-900 dark:text-white">
                                Coop<span class="text-emerald-600 dark:text-emerald-400">Facil</span>
                            </span>
                            <span class="text-[9px] font-bold tracking-widest text-slate-500 dark:text-slate-400 uppercase mt-1">
                                COOPERATIVA FINANCIERA
                            </span>
                        </div>
                    </a>

                    @if (Model.pnlBienvenida.Visible) { <partial name="_MenuPerfil" model="Model" /> }
                </div>

                <nav class="hidden md:flex items-center gap-8 text-sm font-semibold">
                    <a href="../Index.aspx" class="text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition pb-1 border-b-2 border-transparent">Inicio</a>
                    <a href="QuienesSomos.aspx" class="text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition pb-1 border-b-2 border-transparent">Quiénes Somos</a>
                    <a href="Servicios.aspx" class="text-emerald-600 dark:text-emerald-400 font-bold border-b-2 border-emerald-600 dark:border-emerald-400 pb-1">Servicios</a>
                    <a href="Transparencia.aspx" class="text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition pb-1 border-b-2 border-transparent">Transparencia</a>
                    <a href="Contacto.aspx" class="text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition pb-1 border-b-2 border-transparent">Contacto</a>
                    <a href="@Url.Content("~/Pages/Transferencias.aspx")" class="text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition pb-1 border-b-2 border-transparent">Transferencias</a>
                </nav>

                <div class="flex items-center gap-3">
                    <button type="button" onclick="toggleTheme()" id="themeToggleBtn" title="Cambiar Tema" class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-[#0F233D] border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-amber-400 hover:bg-slate-200 dark:hover:bg-slate-800 transition flex items-center justify-center text-base shadow-sm">
                        <i id="themeIconSun" class="fa-solid fa-sun hidden"></i>
                        <i id="themeIconMoon" class="fa-solid fa-moon"></i>
                    </button>

                    @if (Model.lnkIniciarSesion.Visible) { <a id="lnkIniciarSesion" class="@Model.lnkIniciarSesion.CssClass" href="@Url.Content(Model.lnkIniciarSesion.NavigateUrl)">
                        <i class="fa-solid fa-right-to-bracket"></i> Iniciar Sesión
                    </a> }

                    @if (Model.btnCerrarSesion.Visible) { <a id="btnCerrarSesion" class="@Model.btnCerrarSesion.CssClass" href="javascript:__doPostBack('btnCerrarSesion','')">
                        <i class="fa-solid fa-right-from-bracket"></i> Cerrar Sesión
                    </a> }
                </div>

            </header>

            <!-- CONTENIDO PRINCIPAL -->
            <main class="max-w-7xl mx-auto px-6 py-10 flex flex-col gap-10 flex-grow w-full">
                
                <div class="text-center max-w-3xl mx-auto flex flex-col gap-3">
                    <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">PORTAFOLIO INTEGRAL</span>
                    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
                        Soluciones Financieras a tu Medida
                    </h1>
                    <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
                        Diseñamos productos financieros pensados para impulsar tu crecimiento personal, familiar y empresarial con las mejores condiciones del mercado.
                    </p>
                </div>

                <div class="flex flex-wrap justify-center gap-3 mb-10">
                    <button type="button" onclick="filtrarServicios('all', this)" class="btn-filtro active-filter px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold transition shadow-md bg-emerald-600 text-white border border-emerald-500">
                        Todos los servicios
                    </button>
                    <button type="button" onclick="filtrarServicios('credito', this)" class="btn-filtro px-5 py-2.5 rounded-full text-xs sm:text-sm font-medium transition bg-white dark:bg-[#0F233D] text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white border border-slate-300 dark:border-slate-700/80">
                        Crédito
                    </button>
                    <button type="button" onclick="filtrarServicios('ahorro', this)" class="btn-filtro px-5 py-2.5 rounded-full text-xs sm:text-sm font-medium transition bg-white dark:bg-[#0F233D] text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white border border-slate-300 dark:border-slate-700/80">
                        Ahorro e Inversión
                    </button>
                    <button type="button" onclick="filtrarServicios('valor', this)" class="btn-filtro px-5 py-2.5 rounded-full text-xs sm:text-sm font-medium transition bg-white dark:bg-[#0F233D] text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white border border-slate-300 dark:border-slate-700/80">
                        Valor Agregado
                    </button>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    
                    <!-- 1. CUENTA DE AHORRO (LinkButton dinámico con validación de sesión) -->
                    <div class="card-servicio cat-ahorro bg-white dark:bg-[#0F233D] border-2 border-slate-200 dark:border-slate-700/80 rounded-2xl p-6 shadow-sm dark:shadow-xl flex flex-col justify-between hover:border-emerald-500 transition">
                        <div>
                            <div class="w-12 h-12 rounded-xl bg-emerald-500/20 border border-emerald-400/40 flex items-center justify-center mb-4">
                                <i class="fa-solid fa-wallet text-emerald-600 dark:text-emerald-400 text-2xl"></i>
                            </div>
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Cuenta de Ahorro</h3>
                            <p class="text-slate-600 dark:text-slate-300 text-xs sm:text-sm leading-relaxed mb-4">
                                Cuenta principal del socio con rendimiento inmediato, sin comisiones de mantenimiento y disponibilidad 24/7.
                            </p>
                            <ul class="text-xs text-slate-600 dark:text-slate-300 space-y-2 mb-6">
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-600 dark:text-emerald-400"></i> Tasa preferencial 10% ANUAL</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-600 dark:text-emerald-400"></i> Sin cuotas de mantenimiento</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-600 dark:text-emerald-400"></i> Tarjeta débito física y digital</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-600 dark:text-emerald-400"></i> Notificaciones y alertas en tiempo real</li>
                            </ul>
                        </div>
                        @if (Model.btnVerCuentaAhorro.Visible) { <a id="btnVerCuentaAhorro" class="@Model.btnVerCuentaAhorro.CssClass" href="javascript:__doPostBack('btnVerCuentaAhorro','')">
                            Ver condiciones <i class="fa-solid fa-arrow-right text-xs"></i>
                        </a> }
                    </div>

                    <!-- 2. AHORRO PROGRAMADO -->
                    <div class="card-servicio cat-ahorro bg-white dark:bg-[#0F233D] border-2 border-slate-200 dark:border-slate-700/80 rounded-2xl p-6 shadow-sm dark:shadow-xl flex flex-col justify-between hover:border-emerald-500 transition">
                        <div>
                            <div class="w-12 h-12 rounded-xl bg-emerald-500/20 border border-emerald-400/40 flex items-center justify-center mb-4">
                                <i class="fa-solid fa-piggy-bank text-emerald-600 dark:text-emerald-400 text-2xl"></i>
                            </div>
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Ahorro Programado</h3>
                            <p class="text-slate-600 dark:text-slate-300 text-xs sm:text-sm leading-relaxed mb-4">
                                Planifique sus metas de mediano y largo plazo con depósitos periódicos automáticos y rendimiento garantizado.
                            </p>
                            <ul class="text-xs text-slate-600 dark:text-slate-300 space-y-2 mb-6">
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-600 dark:text-emerald-400"></i> Rendimiento hasta 8.0% ANUAL</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-600 dark:text-emerald-400"></i> Plazos flexibles de 6 a 36 meses</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-600 dark:text-emerald-400"></i> Débito automático programable</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-600 dark:text-emerald-400"></i> Cero costos de apertura y gestión</li>
                            </ul>
                        </div>
                        <a href="AhorroProgramado.aspx" class="text-emerald-600 dark:text-emerald-400 font-bold text-xs sm:text-sm hover:underline flex items-center gap-1">
                            Abrir plan <i class="fa-solid fa-arrow-right text-xs"></i>
                        </a>
                    </div>

                    <!-- 3. CRÉDITO PERSONAL -->
                    <div class="card-servicio cat-credito bg-white dark:bg-[#0F233D] border-2 border-slate-200 dark:border-slate-700/80 rounded-2xl p-6 shadow-sm dark:shadow-xl flex flex-col justify-between hover:border-blue-500 transition">
                        <div>
                            <div class="w-12 h-12 rounded-xl bg-blue-500/20 border border-blue-400/40 flex items-center justify-center mb-4">
                                <i class="fa-solid fa-hand-holding-dollar text-blue-600 dark:text-blue-400 text-2xl"></i>
                            </div>
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Crédito Personal</h3>
                            <p class="text-slate-600 dark:text-slate-300 text-xs sm:text-sm leading-relaxed mb-4">
                                Financiamiento de libre inversión para proyectos, imprevistos o consolidación de deudas con desembolso rápido.
                            </p>
                            <ul class="text-xs text-slate-600 dark:text-slate-300 space-y-2 mb-6">
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-blue-600 dark:text-blue-400"></i> Tasa competitiva del 10% ANUAL</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-blue-600 dark:text-blue-400"></i> Plazos extendidos hasta 120 meses</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-blue-600 dark:text-blue-400"></i> Pre-evaluación con dictamen en línea</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-blue-600 dark:text-blue-400"></i> Abonos a capital sin penalización</li>
                            </ul>
                        </div>
                        <a href="CreditoPersonal.aspx" class="text-blue-600 dark:text-blue-400 font-bold text-xs sm:text-sm hover:underline flex items-center gap-1">
                            Solicitar crédito <i class="fa-solid fa-arrow-right text-xs"></i>
                        </a>
                    </div>

                    <!-- 4. CRÉDITO HIPOTECARIO -->
                    <div class="card-servicio cat-credito bg-white dark:bg-[#0F233D] border-2 border-slate-200 dark:border-slate-700/80 rounded-2xl p-6 shadow-sm dark:shadow-xl flex flex-col justify-between hover:border-blue-500 transition">
                        <div>
                            <div class="w-12 h-12 rounded-xl bg-blue-500/20 border border-blue-400/40 flex items-center justify-center mb-4">
                                <i class="fa-solid fa-house-chimney text-blue-600 dark:text-blue-400 text-2xl"></i>
                            </div>
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Crédito Hipotecario</h3>
                            <p class="text-slate-600 dark:text-slate-300 text-xs sm:text-sm leading-relaxed mb-4">
                                Financiamiento para compra de vivienda nueva o usada, construcción o remodelación con asesoría especializada.
                            </p>
                            <ul class="text-xs text-slate-600 dark:text-slate-300 space-y-2 mb-6">
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-blue-600 dark:text-blue-400"></i> Tasa preferencial del 10% ANUAL</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-blue-600 dark:text-blue-400"></i> Plazo de financiamiento hasta 20 años</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-blue-600 dark:text-blue-400"></i> Financiamiento del 100% del inmueble</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-blue-600 dark:text-blue-400"></i> Agendamiento de cita con especialista</li>
                            </ul>
                        </div>
                        <a href="CreditoHipotecario.aspx" class="text-blue-600 dark:text-blue-400 font-bold text-xs sm:text-sm hover:underline flex items-center gap-1">
                            Agendar cita <i class="fa-solid fa-arrow-right text-xs"></i>
                        </a>
                    </div>

                    <!-- 5. CRÉDITO VEHICULAR -->
                    <div class="card-servicio cat-credito bg-white dark:bg-[#0F233D] border-2 border-slate-200 dark:border-slate-700/80 rounded-2xl p-6 shadow-sm dark:shadow-xl flex flex-col justify-between hover:border-blue-500 transition">
                        <div>
                            <div class="w-12 h-12 rounded-xl bg-blue-500/20 border border-blue-400/40 flex items-center justify-center mb-4">
                                <i class="fa-solid fa-car text-blue-600 dark:text-blue-400 text-2xl"></i>
                            </div>
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Crédito Vehicular</h3>
                            <p class="text-slate-600 dark:text-slate-300 text-xs sm:text-sm leading-relaxed mb-4">
                                Adquiera su vehículo nuevo o usado con garantía prendaria, financiación completa del valor comercial y cuota fija.
                            </p>
                            <ul class="text-xs text-slate-600 dark:text-slate-300 space-y-2 mb-6">
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-blue-600 dark:text-blue-400"></i> Tasa preferencial del 10% ANUAL</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-blue-600 dark:text-blue-400"></i> Plazos flexibles de 12 a 72 meses</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-blue-600 dark:text-blue-400"></i> Financiamiento del 100% comercial</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-blue-600 dark:text-blue-400"></i> Aplica para autos nuevos y usados</li>
                            </ul>
                        </div>
                        <a href="CreditoVehicular.aspx" class="text-blue-600 dark:text-blue-400 font-bold text-xs sm:text-sm hover:underline flex items-center gap-1">
                            Cotizar vehículo <i class="fa-solid fa-arrow-right text-xs"></i>
                        </a>
                    </div>

                    <!-- 6. EDUCACIÓN FINANCIERA -->
                    <div class="card-servicio cat-valor bg-white dark:bg-[#0F233D] border-2 border-slate-200 dark:border-slate-700/80 rounded-2xl p-6 shadow-sm dark:shadow-xl flex flex-col justify-between hover:border-amber-400 transition">
                        <div>
                            <div class="w-12 h-12 rounded-xl bg-amber-500/20 border border-amber-400/40 flex items-center justify-center mb-4">
                                <i class="fa-solid fa-graduation-cap text-amber-600 dark:text-amber-400 text-2xl"></i>
                            </div>
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Educación Financiera</h3>
                            <p class="text-slate-600 dark:text-slate-300 text-xs sm:text-sm leading-relaxed mb-4">
                                Talleres, asesorías personalizadas y programas gratuitos para aprender a administrar su presupuesto e inversiones.
                            </p>
                            <ul class="text-xs text-slate-600 dark:text-slate-300 space-y-2 mb-6">
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-amber-600 dark:text-amber-400"></i> Capacitaciones 100% gratuitas</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-amber-600 dark:text-amber-400"></i> Asesoría en elaboración de presupuesto</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-amber-600 dark:text-amber-400"></i> Webinars y módulos interactivos</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-amber-600 dark:text-amber-400"></i> Certificación de educación financiera</li>
                            </ul>
                        </div>
                        <a href="EducacionFinanciera.aspx" class="text-amber-600 dark:text-amber-400 font-bold text-xs sm:text-sm hover:underline flex items-center gap-1">
                            Conocer programas <i class="fa-solid fa-arrow-right text-xs"></i>
                        </a>
                    </div>

                </div>

            </main>
        </div>

        <footer class="bg-white dark:bg-[#0F233D] border-t border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 text-xs text-center py-6 mt-auto transition-colors duration-300">
            <p>© @(DateTime.Now.Year) CoopFacil. Todos los derechos reservados.</p>
        </footer>

    </form>

    <script>
        function updateThemeIcons(isDark) {
            const sunIcon = document.getElementById('themeIconSun');
            const moonIcon = document.getElementById('themeIconMoon');
            if (isDark) {
                sunIcon.classList.remove('hidden');
                moonIcon.classList.add('hidden');
            } else {
                sunIcon.classList.add('hidden');
                moonIcon.classList.remove('hidden');
            }
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('coopfacil-theme', isDark ? 'dark' : 'light');
            updateThemeIcons(isDark);
        }

        function filtrarServicios(categoria, boton) {
            const botones = document.querySelectorAll('.btn-filtro');

            botones.forEach(btn => {
                btn.className = 'btn-filtro px-5 py-2.5 rounded-full text-xs sm:text-sm font-medium transition bg-white dark:bg-[#0F233D] text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white border border-slate-300 dark:border-slate-700/80';
            });

            boton.className = 'btn-filtro active-filter px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold transition shadow-md bg-emerald-600 text-white border border-emerald-500';

            const tarjetas = document.querySelectorAll('.card-servicio');
            tarjetas.forEach(card => {
                if (categoria === 'all') {
                    card.style.display = 'flex';
                } else if (card.classList.contains('cat-' + categoria)) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            const isDark = document.documentElement.classList.contains('dark');
            updateThemeIcons(isDark);
        });
    </script>
<partial name="_PostBack" />
</body>
</html>