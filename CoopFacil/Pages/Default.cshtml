@page "/Default.aspx"
@model CoopFacil.Default
@{
    Layout = null;
}

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="es" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CoopFacil - Iniciar Sesión</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
tailwind.config = {
    darkMode: 'class',
    theme: {
        extend: {
            colors: { coop: { darkBg: '#0B1A30', darkCard: '#0F233D', emerald: '#10B981', blue: '#3B82F6' } }
        }
    }
}
</script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script>
        (function() {
            const savedTheme = localStorage.getItem('coopfacil-theme');
            if (savedTheme === 'light') { document.documentElement.classList.remove('dark'); }
            else { document.documentElement.classList.add('dark'); }
        })();
    </script>
</head>
<body class="bg-slate-50 dark:bg-[#0B1A30] text-slate-800 dark:text-slate-100 font-sans antialiased min-h-screen flex flex-col justify-between transition-colors duration-300">
    <form method="post" id="form1" autocomplete="off" class="min-h-screen flex flex-col justify-between">@Model.CamposOcultos()
        
        <header class="border-b border-slate-200 dark:border-slate-800 bg-white/90 dark:bg-[#0B1A30]/90 sticky top-0 z-40 backdrop-blur transition-colors duration-300">
            <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
                <a href="Index.aspx" class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-emerald-500/10 dark:bg-emerald-600/20 border border-emerald-500/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 text-xl shadow-inner">
                        <i class="fa-solid fa-users-gear"></i>
                    </div>
                    <div>
                        <span class="text-xl font-bold tracking-tight block leading-none text-slate-900 dark:text-white">
                            Coop<span class="text-emerald-600 dark:text-emerald-400">Facil</span>
                        </span>
                        <span class="text-[9px] text-slate-500 dark:text-slate-400 tracking-wider uppercase font-bold mt-0.5 block">Cooperativa Financiera</span>
                    </div>
                </a>

                <button type="button" onclick="toggleTheme()" id="themeToggleBtn" title="Cambiar Tema" class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-[#0F233D] border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-amber-400 hover:bg-slate-200 dark:hover:bg-slate-800 transition flex items-center justify-center text-base shadow-sm">
                    <i id="themeIconSun" class="fa-solid fa-sun hidden"></i>
                    <i id="themeIconMoon" class="fa-solid fa-moon"></i>
                </button>
            </div>
        </header>

        <main class="max-w-7xl mx-auto px-6 py-12 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center flex-grow w-full">
            
            <div class="lg:col-span-7 space-y-6">
                <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-xs font-bold text-emerald-700 dark:text-emerald-400">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    Cooperativa Regulada · Vigilada e Institucional
                </div>

                <h1 class="text-4xl md:text-6xl font-extrabold text-slate-900 dark:text-white leading-tight tracking-tight">
                    Finanzas que <br />
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-teal-500 dark:from-emerald-400 dark:to-teal-200">construyen comunidad</span> <br />
                    desde 1987
                </h1>

                <p class="text-slate-600 dark:text-slate-300 text-base md:text-lg max-w-xl leading-relaxed">
                    CoopFacil es la cooperativa de ahorro y crédito de mayor crecimiento en la región, democratizando el acceso a servicios financieros sólidos y transparentes.
                </p>

                <div class="pt-8 grid grid-cols-2 sm:grid-cols-4 gap-6 border-t border-slate-200 dark:border-slate-800">
                    <div>
                        <p class="text-2xl md:text-3xl font-black text-slate-900 dark:text-white">$100M</p>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Activos gestionados</p>
                    </div>
                    <div>
                        <p class="text-2xl md:text-3xl font-black text-slate-900 dark:text-white">39</p>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Años de trayectoria</p>
                    </div>
                    <div>
                        <p class="text-2xl md:text-3xl font-black text-slate-900 dark:text-white">@if (Model.lblSocios.Visible) { <span id="lblSocios" class="@Model.lblSocios.CssClass">@Html.Raw(Model.lblSocios.Text)</span> }</p>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Socios registrados</p>
                    </div>
                    <div>
                        <p class="text-2xl md:text-3xl font-black text-emerald-600 dark:text-emerald-400">100%</p>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Satisfacción</p>
                    </div>
                </div>
            </div>

            <!-- TARJETA INICIO SESIÓN -->
            <div class="lg:col-span-5">
                <div class="bg-white dark:bg-[#0F233D] border border-slate-200 dark:border-slate-700/80 rounded-2xl p-6 sm:p-8 shadow-xl">
                    <div class="border-b border-slate-200 dark:border-slate-700/50 pb-4 mb-6 text-center">
                        <h2 class="font-extrabold text-slate-900 dark:text-white text-xl">
                            Iniciar Sesión
                        </h2>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Ingresa con tus credenciales de socio</p>
                    </div>

                    @if (Model.pnlMensaje.Visible) { <div id="pnlMensaje" class="@Model.pnlMensaje.CssClass">
                        <i class="fa-solid fa-circle-exclamation text-base"></i>
                        @Model.Lit(Model.litError)
                    </div> }

                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Correo Electrónico</label>
                            @if (Model.txtEmail.Visible) { <input type="email" id="txtEmail" name="txtEmail" class="@Model.txtEmail.CssClass" disabled="@(Model.txtEmail.Enabled ? null : "disabled")" autocomplete="off" placeholder="ejemplo@@correo.com" value="@Model.txtEmail.Text" @Html.Raw(Model.txtEmail.AtributosExtra()) /> }
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Contraseña</label>
                            @if (Model.txtPassword.Visible) { <input type="password" id="txtPassword" name="txtPassword" class="@Model.txtPassword.CssClass" disabled="@(Model.txtPassword.Enabled ? null : "disabled")" autocomplete="off" placeholder="••••••••" @Html.Raw(Model.txtPassword.AtributosExtra()) /> }
                        </div>

                        @if (Model.btnAcceder.Visible) { <input type="submit" name="btnAcceder" id="btnAcceder" value="@Model.btnAcceder.Text" class="@Model.btnAcceder.CssClass" @Html.Raw(Model.btnAcceder.AtributosExtra()) /> }

                        <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 pt-3 border-t border-slate-200 dark:border-slate-800">
                            <span>¿No tienes cuenta?</span>
                            <a href="Pages/Registro.aspx" class="text-emerald-600 dark:text-emerald-400 font-bold hover:underline">Registrarse</a>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <footer class="bg-white dark:bg-[#0F233D] border-t border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 text-xs text-center py-6 mt-auto transition-colors duration-300">
            <p>© @(DateTime.Now.Year) CoopFacil. Todos los derechos reservados.</p>
        </footer>

    </form>

    <script>
        function updateThemeIcons(isDark) {
            const sunIcon = document.getElementById('themeIconSun');
            const moonIcon = document.getElementById('themeIconMoon');
            if (isDark) {
                sunIcon.classList.remove('hidden');
                moonIcon.classList.add('hidden');
            } else {
                sunIcon.classList.add('hidden');
                moonIcon.classList.remove('hidden');
            }
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('coopfacil-theme', isDark ? 'dark' : 'light');
            updateThemeIcons(isDark);
        }

        document.addEventListener('DOMContentLoaded', function () {
            const isDark = document.documentElement.classList.contains('dark');
            updateThemeIcons(isDark);
        });
    </script>
<partial name="_PostBack" />
</body>
</html>