@page "/Pages/Transferencias.aspx"
@model CoopFacil.Pages.Transferencias
@using CoopFacil.Helpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="es" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Transferencias - CoopFacil</title>
    <meta name="description" content="CoopFacil: cooperativa de ahorro y crédito. Abre tu cuenta, solicita créditos con tasa preferencial y envía dinero a otros socios." />
    <meta name="theme-color" content="#0B1A30" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/estilos.css" asp-append-version="true" />
    <link rel="stylesheet" href="@Url.Content("~/css/tarjeta.css")" />
    <script>
    (function () {
        const savedTheme = localStorage.getItem('coopfacil-theme');
        if (savedTheme === 'light') { document.documentElement.classList.remove('dark'); }
        else { document.documentElement.classList.add('dark'); }
    })();
    </script>
</head>
<body class="bg-slate-50 dark:bg-[#0B1A30] text-slate-800 dark:text-slate-100 font-sans antialiased min-h-screen flex flex-col justify-between transition-colors duration-300">
    <form method="post" id="form1" autocomplete="off" class="min-h-screen flex flex-col justify-between">@Model.CamposOcultos()
        
        <div>
            <!-- BARRA DE NAVEGACIÓN PRINCIPAL -->
            <header class="bg-white/90 dark:bg-[#0B1A30]/95 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 sticky top-0 z-50 w-full px-6 sm:px-10 py-4 flex items-center justify-between gap-4 transition-colors duration-300">
                
                <div class="flex items-center gap-4">
                    <a href="../Index.aspx" class="flex items-center gap-3 group">
                        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 dark:bg-emerald-600/20 border border-emerald-500/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 text-xl shadow-inner group-hover:scale-105 transition-transform">
                            <i class="fa-solid fa-users-gear"></i>
                        </div>
                        <div class="flex flex-col">
                            <span class="text-xl font-extrabold tracking-tight leading-none text-slate-900 dark:text-white">
                                Coop<span class="text-emerald-600 dark:text-emerald-400">Facil</span>
                            </span>
                            <span class="hidden sm:block text-[9px] font-bold tracking-widest text-slate-500 dark:text-slate-400 uppercase mt-1">
                                COOPERATIVA FINANCIERA
                            </span>
                        </div>
                    </a>

                    @if (Model.pnlBienvenida.Visible) { <partial name="_MenuPerfil" model="Model" /> }
                </div>

                <nav class="hidden lg:flex items-center gap-8 text-sm font-semibold">
                    <a href="../Index.aspx" class="text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition pb-1 border-b-2 border-transparent">Inicio</a>
                    <a href="QuienesSomos.aspx" class="text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition pb-1 border-b-2 border-transparent">Quiénes Somos</a>
                    <a href="Servicios.aspx" class="text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition pb-1 border-b-2 border-transparent">Servicios</a>
                    <a href="Transparencia.aspx" class="text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition pb-1 border-b-2 border-transparent">Transparencia</a>
                    <a href="Contacto.aspx" class="text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition pb-1 border-b-2 border-transparent">Contacto</a>
                    <a href="Transferencias.aspx" class="text-emerald-600 dark:text-emerald-400 font-bold border-b-2 border-emerald-600 dark:border-emerald-400 pb-1">Transferencias</a>
                </nav>

                <div class="flex items-center gap-3">
                    <button type="button" onclick="toggleTheme()" id="themeToggleBtn" title="Cambiar Tema" class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-[#0F233D] border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-amber-400 hover:bg-slate-200 dark:hover:bg-slate-800 transition flex items-center justify-center text-base shadow-sm">
                        <i id="themeIconSun" class="fa-solid fa-sun hidden"></i>
                        <i id="themeIconMoon" class="fa-solid fa-moon"></i>
                    </button>

                    @if (Model.lnkIniciarSesion.Visible) { <a id="lnkIniciarSesion" class="@Model.lnkIniciarSesion.CssClass" href="@Url.Content(Model.lnkIniciarSesion.NavigateUrl)">
                        <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i> <span class="hidden min-[400px]:inline">Iniciar Sesión</span><span class="sr-only min-[400px]:hidden">Iniciar Sesión</span>
                    </a> }

                    @if (Model.btnCerrarSesion.Visible) { <a id="btnCerrarSesion" class="@Model.btnCerrarSesion.CssClass" href="javascript:__doPostBack('btnCerrarSesion','')">
                        <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i> <span class="hidden min-[400px]:inline">Cerrar Sesión</span><span class="sr-only min-[400px]:hidden">Cerrar Sesión</span>
                    </a> }
                </div>

            </header>

            <!-- CONTENIDO PRINCIPAL -->
            <main class="max-w-7xl mx-auto px-6 py-10 flex flex-col gap-8 flex-grow w-full">

                <div class="flex flex-col gap-1">
                    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">Mi cuenta y transferencias</h1>
                    <p class="text-sm text-slate-500 dark:text-slate-400">Envía y recibe dinero entre cuentas de socios de CoopFacil, al instante.</p>
                </div>

                <div class="grid lg:grid-cols-5 gap-8 items-start">

                    <!-- TARJETA VIRTUAL -->
                    <section class="lg:col-span-2 flex flex-col gap-4">
                        @{ var tarjeta = BancoDatos.GenerarDatosTarjeta(Model.Perfil.NumeroCuenta); }
                        <div class="tarjeta-wrap">
                            <div class="tarjeta" aria-label="Tarjeta virtual de débito CoopFacil">
                                <div class="tarjeta-brillo"></div>
                                <div class="tarjeta-top">
                                    <div>
                                        <p class="tarjeta-marca">CoopFacil</p>
                                        <p class="tarjeta-tipo">Débito</p>
                                    </div>
                                    <i class="fa-solid fa-wifi tarjeta-nfc"></i>
                                </div>
                                <div class="tarjeta-chip"></div>
                                <p class="tarjeta-numero">@tarjeta.Numero</p>
                                <div class="tarjeta-pie">
                                    <div class="tarjeta-titular">
                                        <span>Titular</span>
                                        <strong>@Model.Perfil.Nombre</strong>
                                    </div>
                                    <div class="tarjeta-datos">
                                        <div>
                                            <span>Vence</span>
                                            <strong>@tarjeta.Vence</strong>
                                        </div>
                                        <div>
                                            <span>CVV</span>
                                            <strong><b id="cvvValor" data-cvv="@tarjeta.Cvv">•••</b><button type="button" class="tarjeta-cvv-btn" id="btnCvv" aria-label="Mostrar u ocultar CVV" title="Mostrar u ocultar CVV"><i class="fa-solid fa-eye"></i></button></strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white dark:bg-[#0F233D] border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm">
                            <p class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Saldo disponible</p>
                            <p class="text-3xl font-extrabold text-emerald-600 dark:text-emerald-400 mt-1">$@Model.Perfil.Saldo.ToString("N2")</p>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-2">Tu número de cuenta para recibir dinero: <span class="font-bold text-slate-700 dark:text-slate-200 font-mono">@BancoDatos.FormatearCuenta(Model.Perfil.NumeroCuenta)</span></p>
                        </div>
                    </section>

                    <!-- FORMULARIOS -->
                    <section class="lg:col-span-3 flex flex-col gap-6">

                        <div id="transferir" class="bg-white dark:bg-[#0F233D] border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm flex flex-col gap-4">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/30 text-blue-600 dark:text-blue-400 flex items-center justify-center"><i class="fa-solid fa-money-bill-transfer"></i></div>
                                <div>
                                    <h2 class="text-lg font-bold text-slate-900 dark:text-white">Transferir dinero</h2>
                                    <p class="text-xs text-slate-500 dark:text-slate-400">A otra cuenta de CoopFacil, por número de cuenta (12 dígitos) o por correo</p>
                                </div>
                            </div>

                            @if (Model.SeccionMensaje == "transferir" && Model.MensajeTexto != "") {
                                <div class="p-3 rounded-lg text-xs font-medium border @(Model.MensajeExito ? "bg-emerald-100 dark:bg-emerald-900/40 border-emerald-300 dark:border-emerald-500 text-emerald-800 dark:text-emerald-200" : "bg-red-100 dark:bg-red-900/50 border-red-300 dark:border-red-500 text-red-800 dark:text-red-200")">@Model.MensajeTexto</div>
                            }

                            <div class="grid sm:grid-cols-2 gap-4">
                                <div class="sm:col-span-2">
                                    <label class="block text-xs font-bold text-slate-600 dark:text-slate-300 mb-1" for="txtDestino">Cuenta o correo del destinatario</label>
                                    <input type="text" id="txtDestino" name="txtDestino" class="w-full bg-slate-50 dark:bg-[#071322] border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2.5 text-sm text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition" placeholder="1002 3456 7890 o correo@@ejemplo.com" value="@Model.txtDestino.Text" data-enter="btnTransferir" />
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-600 dark:text-slate-300 mb-1" for="txtMonto">Monto (USD)</label>
                                    <input type="text" inputmode="decimal" id="txtMonto" name="txtMonto" class="w-full bg-slate-50 dark:bg-[#071322] border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2.5 text-sm text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition" placeholder="0.00" value="@Model.txtMonto.Text" data-enter="btnTransferir" />
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-600 dark:text-slate-300 mb-1" for="txtConcepto">Concepto (opcional)</label>
                                    <input type="text" id="txtConcepto" name="txtConcepto" maxlength="150" class="w-full bg-slate-50 dark:bg-[#071322] border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2.5 text-sm text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition" placeholder="Ej. Pago de almuerzo" value="@Model.txtConcepto.Text" data-enter="btnTransferir" />
                                </div>
                            </div>
                            <button type="submit" name="btnTransferir" id="btnTransferir" class="w-full sm:w-fit bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 px-8 rounded-lg text-sm transition cursor-pointer shadow-lg shadow-blue-900/20"><i class="fa-solid fa-paper-plane mr-2"></i>@Model.btnTransferir.Text</button>
                        </div>

                        <div id="depositar" class="bg-white dark:bg-[#0F233D] border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm flex flex-col gap-4">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 flex items-center justify-center"><i class="fa-solid fa-piggy-bank"></i></div>
                                <div>
                                    <h2 class="text-lg font-bold text-slate-900 dark:text-white">Depositar saldo</h2>
                                    <p class="text-xs text-slate-500 dark:text-slate-400">Agrega saldo a tu cuenta · máximo $@BancoDatos.DepositoMaximo.ToString("N2") por depósito</p>
                                </div>
                            </div>

                            @if (Model.SeccionMensaje == "depositar" && Model.MensajeTexto != "") {
                                <div class="p-3 rounded-lg text-xs font-medium border @(Model.MensajeExito ? "bg-emerald-100 dark:bg-emerald-900/40 border-emerald-300 dark:border-emerald-500 text-emerald-800 dark:text-emerald-200" : "bg-red-100 dark:bg-red-900/50 border-red-300 dark:border-red-500 text-red-800 dark:text-red-200")">@Model.MensajeTexto</div>
                            }

                            <div class="flex flex-col sm:flex-row gap-3 sm:items-end">
                                <div class="flex-1">
                                    <label class="block text-xs font-bold text-slate-600 dark:text-slate-300 mb-1" for="txtMontoDeposito">Monto (USD)</label>
                                    <input type="text" inputmode="decimal" id="txtMontoDeposito" name="txtMontoDeposito" class="w-full bg-slate-50 dark:bg-[#071322] border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2.5 text-sm text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition" placeholder="0.00" value="@Model.txtMontoDeposito.Text" data-enter="btnDepositar" />
                                </div>
                                <button type="submit" name="btnDepositar" id="btnDepositar" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3 px-8 rounded-lg text-sm transition cursor-pointer shadow-lg shadow-emerald-900/20"><i class="fa-solid fa-plus mr-2"></i>@Model.btnDepositar.Text</button>
                            </div>
                        </div>
                    </section>
                </div>

                <!-- MOVIMIENTOS -->
                <section id="movimientos" class="bg-white dark:bg-[#0F233D] border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm flex flex-col gap-4">
                    <div class="flex items-center justify-between gap-3">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-slate-500/10 border border-slate-500/30 text-slate-600 dark:text-slate-300 flex items-center justify-center"><i class="fa-solid fa-list-ul"></i></div>
                            <div>
                                <h2 class="text-lg font-bold text-slate-900 dark:text-white">Movimientos</h2>
                                <p class="text-xs text-slate-500 dark:text-slate-400"><span class="text-emerald-600 dark:text-emerald-400 font-bold">Verde</span>: dinero recibido o depositado · <span class="text-red-600 dark:text-red-400 font-bold">Rojo</span>: dinero enviado</p>
                            </div>
                        </div>
                        <span class="bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/30 text-xs font-bold px-3 py-1 rounded-full">@Model.Movimientos.Count</span>
                    </div>

                    @if (Model.Movimientos.Count == 0) {
                        <p class="p-6 text-center text-slate-400 italic text-sm">Aún no tienes movimientos.</p>
                    } else {
                        <ul class="divide-y divide-slate-200 dark:divide-slate-800">
                            @foreach (var m in Model.Movimientos) {
                                <li class="py-3 flex items-center gap-4">
                                    <div class="w-10 h-10 shrink-0 rounded-full flex items-center justify-center @(m.EsPositivo ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : "bg-red-500/10 text-red-600 dark:text-red-400")">
                                        <i class="fa-solid @(m.EsPositivo ? "fa-arrow-down" : "fa-arrow-up")"></i>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm font-semibold text-slate-800 dark:text-slate-100 truncate">@m.Descripcion</p>
                                        <p class="text-[11px] text-slate-500 dark:text-slate-400">@m.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
                                    </div>
                                    <div class="text-right shrink-0">
                                        <p class="text-sm font-extrabold @(m.EsPositivo ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">@(m.EsPositivo ? "+" : "-")$@m.Monto.ToString("N2")</p>
                                        <p class="text-[11px] text-slate-500 dark:text-slate-400">Saldo $@m.SaldoResultante.ToString("N2")</p>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </section>

            </main>
        </div>

        <footer class="bg-white dark:bg-[#0F233D] border-t border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 text-xs text-center py-6 mt-auto transition-colors duration-300">
            <p>© @(DateTime.Now.Year) CoopFacil. Todos los derechos reservados.</p>
        </footer>

    </form>

    <script>
        // Con Enter, cada campo envía su propio botón (en una sola formulario el navegador usaría el primero).
        document.querySelectorAll('[data-enter]').forEach(function (campo) {
            campo.addEventListener('keydown', function (ev) {
                if (ev.key === 'Enter') { ev.preventDefault(); document.getElementById(campo.getAttribute('data-enter')).click(); }
            });
        });
        // Mostrar u ocultar el CVV de la tarjeta.
        (function () {
            var boton = document.getElementById('btnCvv'), valor = document.getElementById('cvvValor');
            if (!boton || !valor) return;
            boton.addEventListener('click', function () {
                var oculto = valor.textContent === '•••';
                valor.textContent = oculto ? valor.getAttribute('data-cvv') : '•••';
                boton.firstElementChild.className = oculto ? 'fa-solid fa-eye-slash' : 'fa-solid fa-eye';
            });
        })();
        // Tras enviar un formulario, volver a la sección donde está el resultado.
        (function () {
            var seccion = '@Model.SeccionMensaje';
            if (seccion) { var el = document.getElementById(seccion); if (el) el.scrollIntoView({ block: 'center' }); }
        })();
    </script>

    <script>
        function updateThemeIcons(isDark) {
            const sunIcon = document.getElementById('themeIconSun');
            const moonIcon = document.getElementById('themeIconMoon');
            if (isDark) {
                sunIcon.classList.remove('hidden');
                moonIcon.classList.add('hidden');
            } else {
                sunIcon.classList.add('hidden');
                moonIcon.classList.remove('hidden');
            }
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('coopfacil-theme', isDark ? 'dark' : 'light');
            updateThemeIcons(isDark);
        }

        document.addEventListener('DOMContentLoaded', function () {
            const isDark = document.documentElement.classList.contains('dark');
            updateThemeIcons(isDark);
        });
    </script>
<script src="~/Js/menu-movil.js" asp-append-version="true"></script>
<script src="~/Js/formularios.js" asp-append-version="true"></script>
<partial name="_PostBack" />
</body>
</html>