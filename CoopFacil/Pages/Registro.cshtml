@page "/Pages/Registro.aspx"
@model CoopFacil.Pages.Registro
@{
    Layout = null;
}

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="es" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registro de Socio - CoopFacil</title>
    <meta name="description" content="CoopFacil: cooperativa de ahorro y crédito. Abre tu cuenta, solicita créditos con tasa preferencial y envía dinero a otros socios." />
    <meta name="theme-color" content="#0B1A30" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/estilos.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/paginas.css" asp-append-version="true" />
    <script>
    (function () {
        const savedTheme = localStorage.getItem('coopfacil-theme');
        if (savedTheme === 'light') { document.documentElement.classList.remove('dark'); }
        else { document.documentElement.classList.add('dark'); }
    })();
</script>
</head>
<body class="bg-slate-50 dark:bg-[#0B1A30] text-slate-800 dark:text-slate-100 font-sans antialiased min-h-screen flex items-center justify-center p-4 pt-20 pb-8 sm:pt-4 sm:pb-4 transition-colors duration-300 relative">
    
    <!-- BOTÓN CAMBIO DE TEMA EN ESQUINA SUPERIOR DERECHA -->
    <button type="button" onclick="toggleTheme()" id="themeToggleBtn" title="Cambiar Tema" class="absolute top-4 right-4 w-10 h-10 rounded-xl bg-white dark:bg-[#0F233D] border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-amber-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition flex items-center justify-center text-base shadow-sm">
        <i id="themeIconSun" class="fa-solid fa-sun hidden"></i>
        <i id="themeIconMoon" class="fa-solid fa-moon"></i>
    </button>

    <form method="post" id="form1" autocomplete="off" class="w-full max-w-md">@Model.CamposOcultos()
        
        <div class="bg-white dark:bg-[#0F233D] border border-slate-200 dark:border-slate-700/60 rounded-2xl p-6 sm:p-8 shadow-xl dark:shadow-2xl transition-colors duration-300">
            
            <div class="text-center mb-6">
                <a href="../Default.aspx" class="inline-flex items-center gap-2 mb-2 group">
                    <div class="relative flex items-center justify-center bg-slate-100 dark:bg-[#071322] p-2 rounded-full border border-slate-300 dark:border-slate-700 group-hover:scale-105 transition-transform">
                        <i class="fa-solid fa-user text-lg text-blue-600 dark:text-blue-500"></i>
                        <i class="fa-solid fa-user text-lg text-emerald-600 dark:text-emerald-500 -ml-1"></i>
                    </div>
                    <span class="text-lg font-bold text-slate-900 dark:text-white"><span class="text-blue-600 dark:text-blue-500">Coop</span><span class="text-emerald-600 dark:text-emerald-500">Facil</span></span>
                </a>
                <h2 class="text-xl font-bold text-slate-900 dark:text-white mt-2">Registro de Nuevo Socio</h2>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Ingresa tus datos para registrarte en la cooperativa</p>
            </div>

            @if (Model.pnlMensaje.Visible) { <div id="pnlMensaje" class="@Model.pnlMensaje.CssClass">
                @Model.Lit(Model.litError)
            </div> }

            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Nombre Completo <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                    @if (Model.txtNombre.Visible) { <input type="text" id="txtNombre" name="txtNombre" class="@Model.txtNombre.CssClass" disabled="@(Model.txtNombre.Enabled ? null : "disabled")" oninput="filtrarSoloLetras(this)" placeholder="Ej. Juan Pérez" value="@Model.txtNombre.Text" @Html.Raw(Model.txtNombre.AtributosExtra()) /> }
                </div>

                <div>
                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Correo Electrónico <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                    @if (Model.txtEmail.Visible) { <input type="email" id="txtEmail" name="txtEmail" class="@Model.txtEmail.CssClass" disabled="@(Model.txtEmail.Enabled ? null : "disabled")" placeholder="correo@@ejemplo.com" value="@Model.txtEmail.Text" @Html.Raw(Model.txtEmail.AtributosExtra()) /> }
                </div>

                <div>
                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Tipo de Acceso <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                    @if (Model.ddlTipoAcceso.Visible) { <select id="ddlTipoAcceso" name="ddlTipoAcceso" class="@Model.ddlTipoAcceso.CssClass" disabled="@(Model.ddlTipoAcceso.Enabled ? null : "disabled")">@foreach (var item in Model.ddlTipoAcceso.Items) { <option value="@item.Value" selected="@(item == Model.ddlTipoAcceso.SelectedItem ? "selected" : null)">@item.Text</option> }</select> }
                </div>

                <div>
                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Contraseña <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                    @if (Model.txtPassword.Visible) { <input type="password" id="txtPassword" name="txtPassword" class="@Model.txtPassword.CssClass" disabled="@(Model.txtPassword.Enabled ? null : "disabled")" placeholder="••••••••" @Html.Raw(Model.txtPassword.AtributosExtra()) /> }
                </div>

                <div>
                    <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Confirmar Contraseña <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                    @if (Model.txtPasswordConfirm.Visible) { <input type="password" id="txtPasswordConfirm" name="txtPasswordConfirm" class="@Model.txtPasswordConfirm.CssClass" disabled="@(Model.txtPasswordConfirm.Enabled ? null : "disabled")" placeholder="••••••••" @Html.Raw(Model.txtPasswordConfirm.AtributosExtra()) /> }
                </div>

                @if (Model.btnRegistrar.Visible) { <input type="submit" name="btnRegistrar" id="btnRegistrar" value="@Model.btnRegistrar.Text" class="@Model.btnRegistrar.CssClass" @Html.Raw(Model.btnRegistrar.AtributosExtra()) /> }

                <div class="text-center text-xs text-slate-500 dark:text-slate-400 pt-2">
                    ¿Ya estás registrado? <a href="../Default.aspx" class="text-blue-600 dark:text-blue-400 font-semibold hover:underline">Iniciar Sesión</a>
                </div>
            </div>
        </div>

    </form>

    <script>
        function updateThemeIcons(isDark) {
            const sunIcon = document.getElementById('themeIconSun');
            const moonIcon = document.getElementById('themeIconMoon');
            if (isDark) {
                sunIcon.classList.remove('hidden');
                moonIcon.classList.add('hidden');
            } else {
                sunIcon.classList.add('hidden');
                moonIcon.classList.remove('hidden');
            }
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('coopfacil-theme', isDark ? 'dark' : 'light');
            updateThemeIcons(isDark);
        }

        function filtrarSoloLetras(input) {
            if (!input) return;
            input.value = input.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ\s]/g, '');
        }

        document.addEventListener('DOMContentLoaded', function () {
            const isDark = document.documentElement.classList.contains('dark');
            updateThemeIcons(isDark);
        });
    </script>
<script src="~/Js/formularios.js" asp-append-version="true"></script>
<script src="~/Js/efectos.js" asp-append-version="true"></script>
    <partial name="_PostBack" />
</body>
</html>