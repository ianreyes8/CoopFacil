@page "/Pages/Contacto.aspx"
@model CoopFacil.Pages.Contacto
@{
    Layout = null;
}

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="es" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contacto - CoopFacil</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
tailwind.config = {
    darkMode: 'class',
    theme: {
        extend: {
            colors: {
                coop: { darkBg: '#0B1A30', darkCard: '#0F233D', emerald: '#10B981', blue: '#3B82F6' }
            }
        }
    }
}
</script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script>
        (function () {
            const savedTheme = localStorage.getItem('coopfacil-theme');
            if (savedTheme === 'light') { document.documentElement.classList.remove('dark'); }
            else { document.documentElement.classList.add('dark'); }
        })();
    </script>
</head>
<body class="bg-slate-50 dark:bg-[#0B1A30] text-slate-800 dark:text-slate-100 font-sans antialiased min-h-screen flex flex-col justify-between transition-colors duration-300">
    <form method="post" id="form1" autocomplete="off" class="min-h-screen flex flex-col justify-between">@Model.CamposOcultos()
        
        <div>
            <!-- BARRA DE NAVEGACIÓN PRINCIPAL -->
            <header class="bg-white/90 dark:bg-[#0B1A30]/95 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 sticky top-0 z-50 w-full px-6 sm:px-10 py-4 flex items-center justify-between gap-4 transition-colors duration-300">
                
                <div class="flex items-center gap-4">
                    <a href="../Index.aspx" class="flex items-center gap-3 group">
                        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 dark:bg-emerald-600/20 border border-emerald-500/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 text-xl shadow-inner group-hover:scale-105 transition-transform">
                            <i class="fa-solid fa-users-gear"></i>
                        </div>
                        <div class="flex flex-col">
                            <span class="text-xl font-extrabold tracking-tight leading-none text-slate-900 dark:text-white">
                                Coop<span class="text-emerald-600 dark:text-emerald-400">Facil</span>
                            </span>
                            <span class="text-[9px] font-bold tracking-widest text-slate-500 dark:text-slate-400 uppercase mt-1">
                                COOPERATIVA FINANCIERA
                            </span>
                        </div>
                    </a>

                    @if (Model.pnlBienvenida.Visible) { <div id="pnlBienvenida" class="@Model.pnlBienvenida.CssClass">
                        <i class="fa-solid fa-circle-user text-emerald-600 dark:text-emerald-400 text-base"></i>
                        <span class="text-xs font-bold text-slate-700 dark:text-white">
                            Bienvenido @Model.Lit(Model.litBienvenida)
                        </span>
                    </div> }
                </div>

                <nav class="hidden md:flex items-center gap-8 text-sm font-semibold">
                    <a href="../Index.aspx" class="text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition pb-1 border-b-2 border-transparent">Inicio</a>
                    <a href="QuienesSomos.aspx" class="text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition pb-1 border-b-2 border-transparent">Quiénes Somos</a>
                    <a href="Servicios.aspx" class="text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition pb-1 border-b-2 border-transparent">Servicios</a>
                    <a href="Transparencia.aspx" class="text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition pb-1 border-b-2 border-transparent">Transparencia</a>
                    <a href="Contacto.aspx" class="text-emerald-600 dark:text-emerald-400 font-bold border-b-2 border-emerald-600 dark:border-emerald-400 pb-1">Contacto</a>
                </nav>

                <div class="flex items-center gap-3">
                    <button type="button" onclick="toggleTheme()" id="themeToggleBtn" title="Cambiar Tema" class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-[#0F233D] border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-amber-400 hover:bg-slate-200 dark:hover:bg-slate-800 transition flex items-center justify-center text-base shadow-sm">
                        <i id="themeIconSun" class="fa-solid fa-sun hidden"></i>
                        <i id="themeIconMoon" class="fa-solid fa-moon"></i>
                    </button>

                    @if (Model.lnkIniciarSesion.Visible) { <a id="lnkIniciarSesion" class="@Model.lnkIniciarSesion.CssClass" href="@Url.Content(Model.lnkIniciarSesion.NavigateUrl)">
                        <i class="fa-solid fa-right-to-bracket"></i> Iniciar Sesión
                    </a> }

                    @if (Model.btnCerrarSesion.Visible) { <a id="btnCerrarSesion" class="@Model.btnCerrarSesion.CssClass" href="javascript:__doPostBack('btnCerrarSesion','')">
                        <i class="fa-solid fa-right-from-bracket"></i> Cerrar Sesión
                    </a> }
                </div>

            </header>

            <!-- CONTENIDO PRINCIPAL: CONTACTO -->
            <main class="max-w-7xl mx-auto px-6 sm:px-10 py-12 flex-grow w-full flex items-center">
                
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 w-full items-start">
                    
                    <!-- IZQUIERDA: INFORMACIÓN DE ATENCIÓN Y CONTACTO -->
                    <div class="lg:col-span-5 flex flex-col justify-center">
                        
                        <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 flex items-center gap-2 mb-3">
                            <span class="w-5 h-[2px] bg-emerald-600 dark:bg-emerald-400 inline-block"></span> ESTAMOS PARA SERVIRLE
                        </span>

                        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight mb-4">
                            Atención personalizada cuando la necesite
                        </h1>

                        <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed mb-8">
                            Nuestro equipo de asesores especializados está disponible por múltiples canales para resolver sus dudas, gestionar sus solicitudes y acompañarle en sus decisiones financieras.
                        </p>

                        <div class="flex flex-col gap-3.5">
                            
                            <div class="bg-white dark:bg-[#0F233D] border border-slate-200 dark:border-slate-700/80 rounded-xl p-4 flex items-center gap-4 shadow-sm dark:shadow-lg hover:border-emerald-500/50 transition">
                                <div class="w-10 h-10 rounded-lg bg-emerald-500/10 dark:bg-emerald-600/20 border border-emerald-500/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 flex-shrink-0">
                                    <i class="fa-solid fa-phone"></i>
                                </div>
                                <div class="flex flex-col">
                                    <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 leading-none mb-1">
                                        Centro de Atención Telefónica
                                    </span>
                                    <span class="text-sm font-bold text-slate-900 dark:text-white tracking-wide">
                                        1800-COOP-UNIDA (2667-8643)
                                    </span>
                                </div>
                            </div>

                            <div class="bg-white dark:bg-[#0F233D] border border-slate-200 dark:border-slate-700/80 rounded-xl p-4 flex items-center gap-4 shadow-sm dark:shadow-lg hover:border-emerald-500/50 transition">
                                <div class="w-10 h-10 rounded-lg bg-emerald-500/10 dark:bg-emerald-600/20 border border-emerald-500/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 flex-shrink-0">
                                    <i class="fa-brands fa-whatsapp text-lg"></i>
                                </div>
                                <div class="flex flex-col">
                                    <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 leading-none mb-1">
                                        Contacto en línea (24/7)
                                    </span>
                                    <span class="text-sm font-bold text-slate-900 dark:text-white tracking-wide">
                                        +503 7777-8888
                                    </span>
                                </div>
                            </div>

                            <div class="bg-white dark:bg-[#0F233D] border border-slate-200 dark:border-slate-700/80 rounded-xl p-4 flex items-center gap-4 shadow-sm dark:shadow-lg hover:border-emerald-500/50 transition">
                                <div class="w-10 h-10 rounded-lg bg-emerald-500/10 dark:bg-emerald-600/20 border border-emerald-500/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 flex-shrink-0">
                                    <i class="fa-solid fa-envelope"></i>
                                </div>
                                <div class="flex flex-col">
                                    <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 leading-none mb-1">
                                        Correo Electrónico
                                    </span>
                                    <span class="text-sm font-bold text-slate-900 dark:text-white tracking-wide">
                                        atencion.coopfacil@@gmail.com
                                    </span>
                                </div>
                            </div>

                            <div class="bg-white dark:bg-[#0F233D] border border-slate-200 dark:border-slate-700/80 rounded-xl p-4 flex items-center gap-4 shadow-sm dark:shadow-lg hover:border-emerald-500/50 transition">
                                <div class="w-10 h-10 rounded-lg bg-emerald-500/10 dark:bg-emerald-600/20 border border-emerald-500/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 flex-shrink-0">
                                    <i class="fa-solid fa-location-dot"></i>
                                </div>
                                <div class="flex flex-col">
                                    <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 leading-none mb-1">
                                        Sede Central
                                    </span>
                                    <span class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white leading-tight">
                                        57 Avenida Norte y Av. Roosevelt, San Salvador - Lun-Vie 8am-6pm
                                    </span>
                                </div>
                            </div>

                        </div>

                    </div>

                    <!-- DERECHA: FORMULARIO DE CONSULTA -->
                    <div class="lg:col-span-7 bg-white dark:bg-[#0F233D] border border-slate-200 dark:border-slate-700/80 rounded-2xl p-6 sm:p-8 shadow-xl">
                        
                        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mb-1">
                            Envíenos un mensaje
                        </h2>
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mb-6">
                            Respuesta garantizada en menos de 4 horas hábiles con comprobante de ticket digital.
                        </p>

                        @if (Model.pnlMensajeExito.Visible) { <div id="pnlMensajeExito" class="@Model.pnlMensajeExito.CssClass">
                            @Model.Lit(Model.litMensaje)
                        </div> }

                        <div class="flex flex-col gap-5">
                            
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Nombre completo <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                                @if (Model.txtNombre.Visible) { <input type="text" id="txtNombre" name="txtNombre" class="@Model.txtNombre.CssClass" disabled="@(Model.txtNombre.Enabled ? null : "disabled")" oninput="filtrarSoloLetras(this)" placeholder="Su nombre" value="@Model.txtNombre.Text" @Html.Raw(Model.txtNombre.AtributosExtra()) /> }
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                                <div>
                                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Correo electrónico <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                                    @if (Model.txtEmail.Visible) { <input type="email" id="txtEmail" name="txtEmail" class="@Model.txtEmail.CssClass" disabled="@(Model.txtEmail.Enabled ? null : "disabled")" placeholder="correo@@ejemplo.com" value="@Model.txtEmail.Text" @Html.Raw(Model.txtEmail.AtributosExtra()) /> }
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Teléfono <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                                    @if (Model.txtTelefono.Visible) { <input type="text" id="txtTelefono" name="txtTelefono" class="@Model.txtTelefono.CssClass" maxlength="9" disabled="@(Model.txtTelefono.Enabled ? null : "disabled")" oninput="formatearTelefono(this)" placeholder="7777-8888" value="@Model.txtTelefono.Text" @Html.Raw(Model.txtTelefono.AtributosExtra()) /> }
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Tipo de consulta <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                                <div class="relative">
                                    @if (Model.ddlTipoConsulta.Visible) { <select id="ddlTipoConsulta" name="ddlTipoConsulta" class="@Model.ddlTipoConsulta.CssClass" disabled="@(Model.ddlTipoConsulta.Enabled ? null : "disabled")">@foreach (var item in Model.ddlTipoConsulta.Items) { <option value="@item.Value" selected="@(item == Model.ddlTipoConsulta.SelectedItem ? "selected" : null)">@item.Text</option> }</select> }
                                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-slate-400">
                                        <i class="fa-solid fa-chevron-down text-xs"></i>
                                    </div>
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Mensaje <span class="text-emerald-600 dark:text-emerald-400">*</span></label>
                                @if (Model.txtMensaje.Visible) { <textarea id="txtMensaje" name="txtMensaje" class="@Model.txtMensaje.CssClass" rows="5" disabled="@(Model.txtMensaje.Enabled ? null : "disabled")" placeholder="Describa su consulta con el mayor detalle posible..." @Html.Raw(Model.txtMensaje.AtributosExtra())>@Model.txtMensaje.Text</textarea> }
                            </div>

                            <div class="pt-1">
                                @if (Model.btnEnviarMensaje.Visible) { <input type="submit" name="btnEnviarMensaje" id="btnEnviarMensaje" value="@Model.btnEnviarMensaje.Text" class="@Model.btnEnviarMensaje.CssClass" @Html.Raw(Model.btnEnviarMensaje.AtributosExtra()) /> }
                            </div>

                        </div>

                    </div>

                </div>

            </main>
        </div>

        <footer class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0F233D] py-6 text-center text-xs text-slate-500 dark:text-slate-400 transition-colors duration-300">
            <p>© @(DateTime.Now.Year) CoopFacil R.L. - Todos los derechos reservados.</p>
        </footer>

    </form>

    <script>
        function updateThemeIcons(isDark) {
            const sunIcon = document.getElementById('themeIconSun');
            const moonIcon = document.getElementById('themeIconMoon');
            if (isDark) {
                sunIcon.classList.remove('hidden');
                moonIcon.classList.add('hidden');
            } else {
                sunIcon.classList.add('hidden');
                moonIcon.classList.remove('hidden');
            }
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('coopfacil-theme', isDark ? 'dark' : 'light');
            updateThemeIcons(isDark);
        }

        function filtrarSoloLetras(input) {
            if (!input) return;
            input.value = input.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ\s]/g, '');
        }

        function formatearTelefono(input) {
            if (!input) return;
            let val = input.value.replace(/\D/g, '');
            if (val.length > 8) val = val.substring(0, 8);
            if (val.length > 4) {
                input.value = val.substring(0, 4) + '-' + val.substring(4, 8);
            } else {
                input.value = val;
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            const isDark = document.documentElement.classList.contains('dark');
            updateThemeIcons(isDark);
        });
    </script>
<partial name="_PostBack" />
</body>
</html>